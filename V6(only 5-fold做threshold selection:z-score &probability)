# ============================================================
# STEP 4
# Metric function
# ============================================================

def calculate_binary_metrics(
    y_true,
    score,
    threshold
):


    y_true = np.asarray(
        y_true,
        dtype=int
    )


    score = np.asarray(
        score,
        dtype=float
    )


    y_pred = (

        score
        >=
        threshold

    ).astype(int)



    TP = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 1)
        )
    )


    FN = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 0)
        )
    )


    TN = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 0)
        )
    )


    FP = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 1)
        )
    )



    sensitivity = (

        TP / (TP + FN)

        if
        (TP + FN) > 0

        else
        np.nan
    )


    specificity = (

        TN / (TN + FP)

        if
        (TN + FP) > 0

        else
        np.nan
    )


    accuracy = (

        (TP + TN)
        /
        len(y_true)
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    PPV = (

        TP / (TP + FP)

        if
        (TP + FP) > 0

        else
        np.nan
    )


    NPV = (

        TN / (TN + FN)

        if
        (TN + FN) > 0

        else
        np.nan
    )


    return {

        "Accuracy":
            accuracy,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "PPV":
            PPV,

        "NPV":
            NPV,

        "Balanced_Accuracy":
            balanced_accuracy,

        "TP":
            TP,

        "FN":
            FN,

        "TN":
            TN,

        "FP":
            FP
    }



# ============================================================
# STEP 5
# OOF true labels and raw probabilities
# ============================================================


# ============================================================
# STEP 5
# Metric function
# ============================================================

def calculate_metrics(
    y_true,
    probability,
    threshold
):

    y_true = np.asarray(
        y_true,
        dtype=int
    )


    probability = np.asarray(
        probability,
        dtype=float
    )


    y_pred = (
        probability
        >=
        threshold
    ).astype(int)



    TP = int(
        np.sum(
            (y_true == 1)
            &
            (y_pred == 1)
        )
    )


    FN = int(
        np.sum(
            (y_true == 1)
            &
            (y_pred == 0)
        )
    )


    TN = int(
        np.sum(
            (y_true == 0)
            &
            (y_pred == 0)
        )
    )


    FP = int(
        np.sum(
            (y_true == 0)
            &
            (y_pred == 1)
        )
    )



    sensitivity = (
        TP / (TP + FN)
        if
        (TP + FN) > 0
        else
        np.nan
    )


    specificity = (
        TN / (TN + FP)
        if
        (TN + FP) > 0
        else
        np.nan
    )


    accuracy = (
        (TP + TN)
        /
        len(y_true)
    )


    balanced_accuracy = (
        sensitivity
        +
        specificity
    ) / 2


    PPV = (
        TP / (TP + FP)
        if
        (TP + FP) > 0
        else
        np.nan
    )


    NPV = (
        TN / (TN + FN)
        if
        (TN + FN) > 0
        else
        np.nan
    )


    return {

        "Accuracy":
            accuracy,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "PPV":
            PPV,

        "NPV":
            NPV,

        "Balanced_Accuracy":
            balanced_accuracy,

        "TP":
            TP,

        "FN":
            FN,

        "TN":
            TN,

        "FP":
            FP
    }



# ============================================================
# STEP 6
# Generate ALL meaningful OOF raw-probability thresholds
#
# For 120 unique scores:
#
#   119 adjacent midpoints
#   + below minimum
#   + above maximum
#   = 121 candidate thresholds
#
# If duplicated probabilities exist, candidate number may be lower.
# ============================================================

unique_probability = np.sort(

    np.unique(
        oof_probability
    )
)


midpoints = (

    unique_probability[:-1]
    +
    unique_probability[1:]

) / 2



candidate_thresholds = np.concatenate(
    [

        [
            np.nextafter(
                unique_probability[0],
                -np.inf
            )
        ],

        midpoints,

        [
            np.nextafter(
                unique_probability[-1],
                np.inf
            )
        ]
    ]
)



print(
    "\nCandidate thresholds =",
    len(candidate_thresholds)
)




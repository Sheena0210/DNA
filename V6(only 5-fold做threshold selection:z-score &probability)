# ============================================================
# STEP 13
# Classification metrics
# ============================================================

def calculate_binary_metrics(

    y_true,

    scores,

    threshold
):


    y_true = np.asarray(
        y_true,
        dtype=int
    )


    scores = np.asarray(
        scores,
        dtype=float
    )


    y_pred = (

        scores
        >=
        threshold

    ).astype(int)



    tp = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 1)
        )
    )


    fn = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 0)
        )
    )


    tn = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 0)
        )
    )


    fp = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 1)
        )
    )



    sensitivity = (

        tp
        /
        (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan
    )


    specificity = (

        tn
        /
        (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan
    )


    accuracy = (

        (tp + tn)
        /
        len(
            y_true
        )
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    ppv = (

        tp
        /
        (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan
    )


    npv = (

        tn
        /
        (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan
    )


    youden = (

        sensitivity
        +
        specificity
        -
        1
    )


    return {

        "threshold":
            float(
                threshold
            ),

        "tp":
            tp,

        "fn":
            fn,

        "tn":
            tn,

        "fp":
            fp,

        "sensitivity":
            sensitivity,

        "specificity":
            specificity,

        "accuracy":
            accuracy,

        "balanced_accuracy":
            balanced_accuracy,

        "ppv":
            ppv,

        "npv":
            npv,

        "youden":
            youden
    }



# ============================================================
# STEP 14
# Threshold selection
#
# Primary:
# maximum Balanced Accuracy
#
# Tie 1:
# minimum |Sensitivity - Specificity|
#
# Tie 2:
# middle threshold
# ============================================================

def select_threshold_by_balanced_accuracy(

    y_true,

    scores
):


    y_true = np.asarray(
        y_true,
        dtype=int
    )


    scores = np.asarray(
        scores,
        dtype=float
    )


    unique_scores = np.sort(

        np.unique(
            scores
        )
    )


    assert len(
        unique_scores
    ) >= 2



    middle_thresholds = (

        unique_scores[:-1]
        +
        unique_scores[1:]

    ) / 2



    epsilon = max(

        1e-12,

        np.std(
            scores
        )
        *
        1e-10
    )



    candidate_thresholds = np.concatenate(
        [

            [
                unique_scores[0]
                -
                epsilon
            ],

            middle_thresholds,

            [
                unique_scores[-1]
                +
                epsilon
            ]
        ]
    )



    records = []


    for threshold in candidate_thresholds:


        metrics = calculate_binary_metrics(

            y_true=
                y_true,

            scores=
                scores,

            threshold=
                threshold
        )


        metrics[
            "sens_spec_difference"
        ] = abs(

            metrics[
                "sensitivity"
            ]

            -

            metrics[
                "specificity"
            ]
        )


        records.append(
            metrics
        )



    table = pd.DataFrame(
        records
    )



    # --------------------------------------------------------
    # Maximum BA
    # --------------------------------------------------------

    max_ba = table[
        "balanced_accuracy"
    ].max()


    candidates = (

        table[

            np.isclose(

                table[
                    "balanced_accuracy"
                ],

                max_ba,

                atol=1e-12
            )
        ]

        .copy()
    )



    # --------------------------------------------------------
    # Tie:
    # smallest sensitivity-specificity difference
    # --------------------------------------------------------

    min_diff = candidates[
        "sens_spec_difference"
    ].min()


    candidates = (

        candidates[

            np.isclose(

                candidates[
                    "sens_spec_difference"
                ],

                min_diff,

                atol=1e-12
            )
        ]

        .copy()
    )



    # --------------------------------------------------------
    # Final tie:
    # middle threshold
    # --------------------------------------------------------

    candidates = (

        candidates

        .sort_values(
            "threshold"
        )

        .reset_index(
            drop=True
        )
    )


    selected = (

        candidates

        .iloc[
            len(candidates) // 2
        ]

        .copy()
    )


    return (
        selected,
        table
    )




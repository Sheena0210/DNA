            "train_reference_sd":
                train_reference_sd,

            "parameter_count":
                combined_parameter_count
        }
    )



    print(
        "\nFold",
        fold_number,
        "FINISHED"
    )


    print(
        "Best epoch =",
        best_epoch
    )


    print(
        "Train AUC =",
        round(
            best_train_result[
                "auc"
            ],
            4
        )
    )


    print(
        "Validation AUC =",
        round(
            best_val_result[
                "auc"
            ],
            4
        )
    )



    # ========================================================
    # Cleanup
    # ========================================================

    del model
    del best_model_state

    del train_dataset
    del train_eval_dataset
    del val_dataset

    del train_loader
    del train_eval_loader
    del val_loader


    gc.collect()



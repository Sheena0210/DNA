# ============================================================
# STEP 5
# Kernel-only model builder
#
# IMPORTANT:
#
# Build ORIGINAL V6 first.
#
# Then replace ONLY conv1:
#
# 7x7 stride2 padding3
#
# ->
#
# 3x3 stride2 padding1
#
# Everything else stays unchanged.
# ============================================================

def build_kernel_only_model(

    seed,

    device,

    dropout_rate=0.5
):


    # --------------------------------------------------------
    # Build original V6
    # --------------------------------------------------------

    set_kernelonly_seed(
        seed
    )


    model = build_exp1_v6_model(

        seed=
            seed,

        device=
            torch.device("cpu"),

        dropout_rate=
            dropout_rate
    )


    # --------------------------------------------------------
    # Replace ONLY stem convolution
    #
    # Original:
    # Conv2d(3, 64, 7x7, stride2, padding3)
    #
    # New:
    # Conv2d(3, 64, 3x3, stride2, padding1)
    # --------------------------------------------------------

    set_kernelonly_seed(
        seed
    )


    new_conv1 = nn.Conv2d(

        in_channels=3,

        out_channels=64,

        kernel_size=3,

        stride=2,

        padding=1,

        bias=False
    )


    nn.init.kaiming_normal_(

        new_conv1.weight,

        mode="fan_out",

        nonlinearity="relu"
    )


    model.conv1 = new_conv1


    model = model.to(
        device
    )


    return model




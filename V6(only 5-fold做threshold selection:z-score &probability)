                    ),

                "train_z_score":
                    float(
                        z_value
                    )
            }
        )



    # ========================================================
    # 15-17
    # Fold summary
    # ========================================================

    fold_records.append(
        {

            "fold":
                fold_number,

            "seed":
                model_seed,

            "best_epoch":
                best_epoch,

            "train_auc":
                float(
                    best_train_result[

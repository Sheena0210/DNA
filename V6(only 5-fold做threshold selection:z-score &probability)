    )



    scheduler = (

        torch.optim.lr_scheduler
        .ReduceLROnPlateau(

            optimizer,

            mode="max",

            factor=
                LR_FACTOR,

            patience=
                LR_PATIENCE,

            min_lr=
                MIN_LEARNING_RATE
        )
    )



    best_val_auc = -np.inf

    best_val_loss = np.inf

    best_epoch = 0

    best_model_state = None

    epochs_without_improvement = 0



    # --------------------------------------------------------
    # Epoch loop
    # --------------------------------------------------------

    for epoch in range(
        1,
        MAX_EPOCHS + 1
    ):


        train_result = train_one_epoch(

            model=
                model,

            data_loader=
                train_loader,

            criterion=
                criterion,

            optimizer=
                optimizer,

            device=
                device_channelonly
        )


        (

            val_result,
            _,
            _,
            _

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device_channelonly
        )


        current_lr = (

            optimizer
            .param_groups[0]["lr"]
        )


        history_records.append(
            {

                "fold":
                    fold_number,

                "epoch":
                    epoch,

                "seed":
                    model_seed,

                "learning_rate":
                    current_lr,

                "train_auc":
                    train_result[
                        "auc"
                    ],

                "val_auc":
                    val_result[
                        "auc"
                    ],

                "train_loss":
                    train_result[
                        "loss"
                    ],

                "val_loss":
                    val_result[
                        "loss"
                    ]
            }
        )


        auc_improved = (

            val_result[
                "auc"
            ]

            >
            best_val_auc
            +
            1e-8
        )


        auc_tie_loss_improved = (

            abs(

                val_result[
                    "auc"
                ]

                -
                best_val_auc

            ) <= 1e-8

            and

            val_result[
                "loss"
            ]

            <
            best_val_loss
        )


        if (

            auc_improved

            or

            auc_tie_loss_improved
        ):


            best_val_auc = float(

                val_result[
                    "auc"
                ]
            )


            best_val_loss = float(

                val_result[
                    "loss"
                ]
            )


            best_epoch = int(
                epoch
            )


            best_model_state = {

                key:

                    value
                    .detach()
                    .cpu()
                    .clone()

                for key, value

                in model
                .state_dict()
                .items()
            }


            epochs_without_improvement = 0


        else:

            epochs_without_improvement += 1



        scheduler.step(

            val_result[
                "auc"
            ]
        )


        print(

            f"Epoch {epoch:02d}"

            f" | Train AUC "
            f"{train_result['auc']:.3f}"

            f" | Val AUC "
            f"{val_result['auc']:.3f}"

            f" | Best "
            f"{best_epoch}"
        )


        if (

            epochs_without_improvement
            >=
            EARLY_STOPPING_PATIENCE
        ):

            print(
                "Early stopping."
            )

            break



    # --------------------------------------------------------
    # Restore best model
    # --------------------------------------------------------

    assert best_model_state is not None


    model.load_state_dict(
        best_model_state
    )


    model.to(
        device_channelonly
    )



    # --------------------------------------------------------

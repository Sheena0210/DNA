# ============================================================
# STEP 5
# Metric function
# ============================================================

def threshold_metrics(
    y_true,
    score,
    threshold
):


    y_true = np.asarray(
        y_true,
        dtype=int
    )


    score = np.asarray(
        score,
        dtype=float
    )


    y_pred = (

        score
        >=
        threshold

    ).astype(int)



    tp = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 1)
        )
    )


    fn = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 0)
        )
    )


    tn = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 0)
        )
    )


    fp = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 1)
        )
    )



    sensitivity = (

        tp / (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan
    )


    specificity = (

        tn / (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan
    )


    accuracy = (

        (tp + tn)
        /
        len(
            y_true
        )
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    ppv = (

        tp / (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan
    )


    npv = (

        tn / (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan
    )


    predicted_positive = int(

        np.sum(
            y_pred == 1
        )
    )


    predicted_negative = int(

        np.sum(
            y_pred == 0
        )
    )


    return {

        "TP":
            tp,

        "FN":
            fn,

        "TN":
            tn,

        "FP":
            fp,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "Accuracy":
            accuracy,

        "Balanced_Accuracy":
            balanced_accuracy,

        "PPV":
            ppv,

        "NPV":
            npv,

        "Predicted_Positive":
            predicted_positive,

        "Predicted_Negative":
            predicted_negative
    }



# ============================================================
# STEP 6
# Evaluate every threshold
# ============================================================

threshold_records = []


for threshold in threshold_grid:


    train_result = threshold_metrics(

        y_true=
            train_y,


        criterion=
            criterion,

        device=
            device_smalllocal
    )



    train_probs_best = np.asarray(

        train_probs_best,

        dtype=float
    )


    val_probs_best = np.asarray(

        val_probs_best,

        dtype=float
    )



    # ========================================================
    # 15-12
    # Training-reference mean / SD
    #
    # Each fold has its own reference.
    # ========================================================

    train_reference_mean = float(

        np.mean(
            train_probs_best
        )
    )


    train_reference_sd = float(

        np.std(

            train_probs_best,

            ddof=0
        )
    )


    assert train_reference_sd > 0



    # ========================================================
    # 15-13
    # OOF probability -> OOF Z-score
    # ========================================================

    val_z_scores = (

        val_probs_best
        -
        train_reference_mean

    ) / train_reference_sd



    # ========================================================
    # 15-14
    # Validation metadata
    # ========================================================

    val_lookup = (


# STEP 5
# Build Kernel + Stride ONLY model
#
# Start from Original V6.
#
# Keep:
#   channels = 64 / 128 / 256 / 512
#   GroupNorm
#   residual blocks
#   dropout
#   GAP
#   classifier
#
# Change:
#
# Stem
#   7x7 stride2
#        ->
#   3x3 stride1
#
# Layer1 first block:
#   stride1
#      ->
#   stride2
#
# Layer1 shortcut:
#   Identity
#      ->
#   AvgPool2d(2,2)
# ============================================================

def build_kernel_stride_only_model(

    seed,
    device,
    dropout_rate=0.5
):


    set_kernel_stride_seed(
        seed
    )


    # --------------------------------------------------------
    # Start from Original V6
    # --------------------------------------------------------

    model = build_exp1_v6_model(

        seed=
            seed,

        device=
            torch.device(
                "cpu"
            ),

        dropout_rate=
            dropout_rate
    )



    # --------------------------------------------------------
    # QC original channels
    # --------------------------------------------------------

    assert (
        model.conv1.out_channels
        ==
        64
    )


    assert (
        model.layer1[0].conv1.in_channels
        ==
        64
    )


    assert (
        model.layer1[0].conv1.out_channels
        ==
        64
    )



    # --------------------------------------------------------
    # CHANGE 1
    #
    # Stem:
    # 7x7 stride2
    # ->
    # 3x3 stride1
    # --------------------------------------------------------

    model.conv1 = nn.Conv2d(

        in_channels=
            3,

        out_channels=
            64,

        kernel_size=
            3,

        stride=
            1,

        padding=
            1,

        bias=
            False
    )


    nn.init.kaiming_normal_(

        model.conv1.weight,

        mode=
            "fan_out",

        nonlinearity=
            "relu"
    )



    # --------------------------------------------------------
    # CHANGE 2
    #
    # Move first downsampling to Layer1 first block.
    #
    # Main branch:
    # Conv 3x3 stride2
    # --------------------------------------------------------

    model.layer1[0].conv1 = nn.Conv2d(

        in_channels=
            64,

        out_channels=
            64,

        kernel_size=
            3,

        stride=
            2,

        padding=
            1,

        bias=
            False
    )


    nn.init.kaiming_normal_(

        model.layer1[0].conv1.weight,

        mode=
            "fan_out",

        nonlinearity=
            "relu"
    )



    # --------------------------------------------------------
    # Shortcut:
    #
    # 720x720
    # ->
    # 360x360
    #
    # No channel change, therefore AvgPool is enough.
    # --------------------------------------------------------

    model.layer1[0].downsample = nn.AvgPool2d(

        kernel_size=
            2,

        stride=
            2
    )



    model = model.to(
        device
    )


    return model




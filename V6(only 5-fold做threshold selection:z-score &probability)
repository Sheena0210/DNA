# ============================================================
# STEP 10
# Metric function
# ============================================================

def channel_raw_metrics(

    y_true,
    scores,
    threshold
):


    y_true = np.asarray(

        y_true,

        dtype=int
    )


    scores = np.asarray(

        scores,

        dtype=float
    )


    y_pred = (

        scores

        >=

        threshold

    ).astype(int)



    tp = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 1)
        )
    )


    fn = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 0)
        )
    )


    tn = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 0)
        )
    )


    fp = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 1)
        )
    )



    sensitivity = (

        tp
        /
        (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan
    )


    specificity = (

        tn
        /
        (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan
    )


    accuracy = (

        (tp + tn)

        /

        len(
            y_true
        )
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    ppv = (

        tp
        /
        (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan
    )


    npv = (

        tn
        /
        (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan
    )



    return {

        "TP":
            tp,

        "FN":
            fn,

        "TN":
            tn,

        "FP":
            fp,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "Accuracy":
            accuracy,

        "Balanced_Accuracy":
            balanced_accuracy,

        "PPV":
            ppv,

        "NPV":
            npv
    }



# ============================================================
# STEP 11
# RAW probability threshold selection
#
# Rule:
#
# 1. Maximum Balanced Accuracy
# 2. Minimum |Sensitivity - Specificity|
# 3. Middle threshold if still tied
#
# Use ONLY 120 OOF subjects
# ============================================================

def select_channel_raw_threshold(

    y_true,
    probabilities
):


    y_true = np.asarray(

        y_true,

        dtype=int
    )


    probabilities = np.asarray(

        probabilities,

        dtype=float
    )



    unique_scores = np.sort(

        np.unique(
            probabilities
        )
    )



    middle_thresholds = (

        unique_scores[:-1]

        +

        unique_scores[1:]

    ) / 2



    epsilon = max(

        1e-12,

        np.std(
            probabilities
        )

        *

        1e-10
    )



    candidate_thresholds = np.concatenate(
        [

            [
                unique_scores[0]
                -
                epsilon
            ],

            middle_thresholds,

            [
                unique_scores[-1]
                +
                epsilon
            ]
        ]
    )



    records = []



    for threshold in candidate_thresholds:


        result = channel_raw_metrics(

            y_true=
                y_true,

            scores=
                probabilities,

            threshold=
                threshold
        )



        records.append(
            {

                "Threshold":
                    float(
                        threshold
                    ),

                "Accuracy":
                    result[
                        "Accuracy"
                    ],

                "Sensitivity":
                    result[
                        "Sensitivity"
                    ],

                "Specificity":
                    result[
                        "Specificity"
                    ],

                "PPV":
                    result[
                        "PPV"
                    ],

                "NPV":
                    result[
                        "NPV"
                    ],

                "Balanced_Accuracy":
                    result[
                        "Balanced_Accuracy"
                    ],

                "TP":
                    result[
                        "TP"
                    ],

                "FN":
                    result[
                        "FN"
                    ],

                "TN":
                    result[
                        "TN"
                    ],

                "FP":
                    result[
                        "FP"
                    ],

                "Sens_Spec_Difference":

                    abs(

                        result[
                            "Sensitivity"
                        ]

                        -

                        result[
                            "Specificity"
                        ]
                    )
            }
        )



    table = pd.DataFrame(
        records
    )



    # --------------------------------------------------------
    # Rule 1
    # Maximum Balanced Accuracy
    # --------------------------------------------------------

    max_ba = (

        table[
            "Balanced_Accuracy"
        ]
        .max()
    )



    candidates = (

        table.loc[

            np.isclose(

                table[
                    "Balanced_Accuracy"
                ],

                max_ba,

                atol=1e-12
            )

        ]

        .copy()
    )



    # --------------------------------------------------------
    # Rule 2
    # Minimum |Sensitivity - Specificity|
    # --------------------------------------------------------

    min_difference = (

        candidates[
            "Sens_Spec_Difference"
        ]
        .min()
    )



    candidates = (

        candidates.loc[

            np.isclose(

                candidates[
                    "Sens_Spec_Difference"
                ],

                min_difference,

                atol=1e-12
            )

        ]

        .copy()

        .sort_values(
            "Threshold"
        )

        .reset_index(
            drop=True
        )
    )



    # --------------------------------------------------------
    # Rule 3
    # Middle threshold
    # --------------------------------------------------------

    selected = candidates.iloc[

        len(candidates)
        //
        2
    ]



    return (

        selected,

        table
    )




# Metric function
# ============================================================

def kernelonly_metrics(

    y_true,

    scores,

    threshold
):


    y_true = np.asarray(

        y_true,

        dtype=int
    )


    scores = np.asarray(

        scores,

        dtype=float
    )


    y_pred = (

        scores
        >=
        threshold

    ).astype(int)



    tp = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 1)
        )
    )


    fn = int(

        np.sum(

            (y_true == 1)

            &

            (y_pred == 0)
        )
    )


    tn = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 0)
        )
    )


    fp = int(

        np.sum(

            (y_true == 0)

            &

            (y_pred == 1)
        )
    )



    sensitivity = (

        tp / (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan
    )


    specificity = (

        tn / (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan
    )


    accuracy = (

        (tp + tn)
        /
        len(
            y_true
        )
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    ppv = (

        tp / (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan
    )


    npv = (

        tn / (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan
    )


    return {

        "TP": tp,

        "FN": fn,

        "TN": tn,

        "FP": fp,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "Accuracy":
            accuracy,

        "Balanced_Accuracy":
            balanced_accuracy,

        "PPV":
            ppv,

        "NPV":
            npv
    }



# ============================================================
# STEP 11
# Threshold selection
#
# Maximum Balanced Accuracy
#
# Tie:
# minimum |Sensitivity - Specificity|
# ============================================================

def select_kernelonly_threshold(

    y_true,

    scores
):


    y_true = np.asarray(

        y_true,

        dtype=int
    )


    scores = np.asarray(

        scores,

        dtype=float
    )


    unique_scores = np.sort(

        np.unique(
            scores
        )
    )


    assert len(
        unique_scores
    ) >= 2


    middle_thresholds = (

        unique_scores[:-1]
        +
        unique_scores[1:]

    ) / 2


    epsilon = max(

        1e-12,

        np.std(
            scores
        )
        *
        1e-10
    )


    candidate_thresholds = np.concatenate(
        [

            [
                unique_scores[0]
                -
                epsilon
            ],

            middle_thresholds,

            [
                unique_scores[-1]
                +
                epsilon
            ]
        ]
    )


    records = []


    for threshold in candidate_thresholds:


        result = kernelonly_metrics(

            y_true=
                y_true,

            scores=
                scores,

            threshold=
                threshold
        )


        records.append(
            {

                "threshold":
                    float(
                        threshold
                    ),

                **result,

                "sens_spec_difference":
                    abs(

                        result[
                            "Sensitivity"
                        ]

                        -

                        result[
                            "Specificity"
                        ]
                    )
            }
        )



    table = pd.DataFrame(
        records
    )


    max_ba = table[
        "Balanced_Accuracy"
    ].max()


    candidates = (

        table[

            np.isclose(

                table[
                    "Balanced_Accuracy"
                ],

                max_ba,

                atol=1e-12
            )
        ]

        .copy()
    )


    min_diff = candidates[
        "sens_spec_difference"
    ].min()


    candidates = (

        candidates[

            np.isclose(

                candidates[
                    "sens_spec_difference"
                ],

                min_diff,

                atol=1e-12
            )
        ]

        .copy()

        .sort_values(
            "threshold"
        )

        .reset_index(
            drop=True
        )
    )


    selected = (

        candidates

        .iloc[
            len(candidates) // 2
        ]
    )


    return (
        selected,
        table
    )




                    ),

                "train_reference_mean":
                    train_reference_mean,

                "train_reference_sd":
                    train_reference_sd,

                "oof_z_score":
                    float(
                        z_value
                    )
            }
        )



    # ========================================================
    # 15-16
    # Save Train96 reference predictions
    # ========================================================

    train_lookup = (

        fold_train_df[

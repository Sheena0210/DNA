        exp1_train_df[

            exp1_train_df[
                "cv_fold"
            ]
            !=
            fold_number
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )



    assert len(
        fold_train_df
    ) == 96


    assert len(
        fold_val_df
    ) == 24


    assert (
        fold_train_df[
            "label"
        ]
        .sum()
        ==
        32
    )


    assert (
        fold_val_df[
            "label"
        ]
        .sum()
        ==
        8
    )



    train_groups = set(

        fold_train_df[
            "group_id"
        ]
    )


    val_groups = set(

        fold_val_df[
            "group_id"
        ]
    )


    assert len(
        train_groups
    ) == 32


    assert len(
        val_groups
    ) == 8


    assert train_groups.isdisjoint(
        val_groups
    )



    # ========================================================
    # 15-3
    # DataLoaders
    # ========================================================

    (

        train_dataset,
        train_eval_dataset,
        val_dataset,

        train_loader,
        train_eval_loader,
        val_loader

    ) = build_final_dataloaders(

        train_df=
            fold_train_df,

        val_df=
            fold_train_df,

        test_df=
            fold_val_df,

        run_seed=
            model_seed,

        batch_size=
            BATCH_SIZE
    )



    # ========================================================
    # 15-4
    # Build combined model
    # ========================================================

    set_smalllocal_seed(
        model_seed
    )


    model = build_v6_small_local_model(

        seed=
            model_seed,

        device=
            device_smalllocal,

        dropout_rate=
            DROPOUT_RATE
    )



    # ========================================================
    # 15-5
    # Same weighted BCE + AdamW
    # ========================================================

    (

        criterion,
        optimizer,
        pos_weight_value

    ) = build_training_objects(

        model=
            model,

        train_df=
            fold_train_df,

        device=
            device_smalllocal,

        learning_rate=
            LEARNING_RATE,

        weight_decay=
            WEIGHT_DECAY
    )



    # ========================================================
    # 15-6
    # LR scheduler
    # ========================================================

    scheduler = (

        torch.optim.lr_scheduler
        .ReduceLROnPlateau(

            optimizer,

            mode="max",

            factor=
                LR_FACTOR,

            patience=
                LR_PATIENCE,

            min_lr=
                MIN_LEARNING_RATE
        )
    )



    # ========================================================
    # 15-7
    # Best epoch tracking
    # ========================================================

    best_val_auc = -np.inf

    best_val_loss = np.inf

    best_epoch = 0

    best_model_state = None

    epochs_without_improvement = 0



    # ========================================================
    # 15-8
    # Training loop
    # ========================================================

    for epoch in range(
        1,
        MAX_EPOCHS + 1
    ):


        train_result = train_one_epoch(

            model=
                model,

            data_loader=
                train_loader,

            criterion=
                criterion,

            optimizer=
                optimizer,

            device=
                device_smalllocal
        )



        (

            val_result,
            _,
            _,
            _

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device_smalllocal
        )



        current_lr = (

            optimizer
            .param_groups[0][
                "lr"
            ]
        )



        history_records.append(
            {

                "fold":
                    fold_number,

                "seed":
                    model_seed,

                "epoch":
                    epoch,

                "learning_rate":
                    current_lr,

                "train_loss":
                    train_result[
                        "loss"
                    ],

                "train_auc":
                    train_result[
                        "auc"
                    ],

                "val_loss":
                    val_result[
                        "loss"
                    ],

                "val_auc":
                    val_result[
                        "auc"
                    ]
            }
        )



        auc_improved = (

            val_result[
                "auc"
            ]

            >
            best_val_auc
            +
            1e-8
        )


        auc_tie_loss_improved = (

            abs(

                val_result[
                    "auc"
                ]

                -
                best_val_auc
            )

            <=
            1e-8

            and

            val_result[
                "loss"
            ]

            <
            best_val_loss
        )


        is_best = (

            auc_improved

            or

            auc_tie_loss_improved
        )



        if is_best:


            best_val_auc = float(

                val_result[
                    "auc"
                ]
            )


            best_val_loss = float(

                val_result[
                    "loss"
                ]
            )


            best_epoch = int(
                epoch
            )


            best_model_state = {

                key:

                    value
                    .detach()
                    .cpu()
                    .clone()

                for key, value

                in model
                .state_dict()
                .items()
            }


            epochs_without_improvement = 0


        else:

            epochs_without_improvement += 1



        scheduler.step(

            val_result[
                "auc"
            ]
        )



        print(

            f"Epoch {epoch:02d}"

            f" | LR {current_lr:.2e}"

            f" | Train AUC "
            f"{train_result['auc']:.3f}"

            f" | Val AUC "
            f"{val_result['auc']:.3f}"

            f" | Best {best_epoch}"
        )



        if (

            epochs_without_improvement

            >=

            EARLY_STOPPING_PATIENCE
        ):

            print(
                "Early stopping."
            )

            break



    # ========================================================
    # 15-9
    # Restore best model
    # ========================================================

    assert best_model_state is not None


    model.load_state_dict(
        best_model_state
    )


    model.to(
        device_smalllocal
    )



    # ========================================================
    # 15-10
    # Deterministic Train96 predictions
    # ========================================================

    (

        best_train_result,
        train_labels_best,
        train_probs_best,
        train_ids_best

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            train_eval_loader,

        criterion=
            criterion,

        device=

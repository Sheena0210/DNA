    original_v6_oof[
        "true_label"
    ]

    .to_numpy(
        dtype=int
    )
)


oof_probability = (

    original_v6_oof[
        "oof_probability"
    ]

    .to_numpy(
        dtype=float
    )
)



# ============================================================
# STEP 6
# Generate ALL candidate raw thresholds
#
# If there are 120 unique probabilities:
#
# 119 midpoints
# + threshold below minimum
# + threshold above maximum
# = 121 candidate thresholds
# ============================================================

unique_scores = np.sort(

    np.unique(
        oof_probability
    )
)


midpoints = (

    unique_scores[:-1]
    +
    unique_scores[1:]

) / 2


epsilon = max(

    1e-12,

    np.std(
        oof_probability
    )
    *
    1e-10
)


candidate_thresholds = np.concatenate(
    [

        [
            unique_scores[0]
            -
            epsilon
        ],

        midpoints,

        [
            unique_scores[-1]
            +
            epsilon
        ]
    ]
)


print(
    "\nNumber of candidate raw thresholds =",
    len(candidate_thresholds)
)



# ============================================================
# STEP 7
# Calculate metrics for every candidate threshold
# ============================================================

threshold_records = []


for threshold in candidate_thresholds:


    result = calculate_binary_metrics(

        y_true=
            oof_y,

        score=
            oof_probability,

        threshold=
            threshold
    )


    threshold_records.append(
        {

            "Threshold":
                float(threshold),

            **result,

            "Sens_Spec_Difference":
                abs(

                    result[
                        "Sensitivity"
                    ]

                    -

                    result[
                        "Specificity"
                    ]
                )
        }
    )


raw_threshold_search_df = pd.DataFrame(
    threshold_records
)



# ============================================================
# STEP 8
# Select best RAW threshold
#
# Rule:
# 1. Maximum Balanced Accuracy
# 2. Minimum |Sensitivity - Specificity|
# 3. Middle threshold if still tied
# ============================================================

max_BA = (

    raw_threshold_search_df[
        "Balanced_Accuracy"
    ]
    .max()
)


best_candidates = (

    raw_threshold_search_df[

        np.isclose(

            raw_threshold_search_df[
                "Balanced_Accuracy"
            ],

            max_BA,

            atol=1e-12
        )
    ]

    .copy()
)


minimum_difference = (

    best_candidates[
        "Sens_Spec_Difference"
    ]
    .min()
)


best_candidates = (

    best_candidates[

        np.isclose(

            best_candidates[
                "Sens_Spec_Difference"
            ],

            minimum_difference,

            atol=1e-12
        )
    ]

    .sort_values(
        "Threshold"
    )

    .reset_index(
        drop=True
    )
)


selected_threshold_row = (

    best_candidates

    .iloc[
        len(best_candidates) // 2
    ]
)



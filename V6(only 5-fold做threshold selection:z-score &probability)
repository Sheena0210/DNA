                    float(z_score)
            }
        )



    fold_records.append(
        {

            "fold":
                fold_number,

            "seed":
                model_seed,

            "best_epoch":
                best_epoch,

            "train_auc":
                float(
                    best_train_result[
                        "auc"
                    ]
                ),

            "val_auc":
                float(

    )



    # ========================================================
    # Validation24
    # OOF raw probability
    # ========================================================

    (

        best_val_result,
        val_labels,
        val_probs,
        val_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            val_loader,

        criterion=
            criterion,

        device=
            device_ks
    )



    val_probs = np.asarray(

        val_probs,


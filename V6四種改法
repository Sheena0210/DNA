# STEP 9
# 解析原本 V6 Dataset item
#
# 支援：
#
# tuple/list
# 或
# dictionary
# ============================================================

def unpack_v6_dataset_item(item):


    # --------------------------------------------------------
    # Dictionary
    # --------------------------------------------------------

    if isinstance(
        item,
        dict
    ):


        image = None
        label = None
        sample_id = None


        for key in [
            "image",
            "images",
            "x"
        ]:

            if key in item:

                image = item[key]

                break


        for key in [
            "label",
            "target",
            "y"
        ]:

            if key in item:

                label = item[key]

                break


        for key in [
            "psam_IID",
            "sample_id",
            "IID",
            "id"
        ]:

            if key in item:

                sample_id = item[key]

                break


        if (
            image is None
            or
            label is None
            or
            sample_id is None
        ):

            raise ValueError(
                "無法解析 Dataset dictionary item。"
            )


        return (
            image,
            label,
            str(sample_id)
        )



    # --------------------------------------------------------
    # Tuple / List
    #
    # 預期至少：
    #
    # image
    # label
    # psam_IID
    # --------------------------------------------------------

    if isinstance(
        item,
        (tuple, list)
    ):


        if len(item) < 3:

            raise ValueError(
                "Dataset item 少於三個元素。"
            )


        image = item[0]

        label = item[1]

        sample_id = item[2]


        return (
            image,
            label,
            str(sample_id)
        )


    raise TypeError(
        "無法辨識 Dataset item format："
        f"{type(item)}"
    )




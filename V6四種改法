# ============================================================
# 10. 建立單一 Repeat × Fold Training Function
# ============================================================

def train_repeated_v6_fold(
    train_df,
    repeat_number,
    fold_number,
    fold_groups,
    device
):


    # ========================================================
    # 10-1. Model / Training Seed
    # ========================================================

    model_seed = (

        REPEATED_TRAINING_SEED
        +
        repeat_number * 100
        +
        fold_number
    )


    set_repeated_cv_seed(

        model_seed
    )


    print(
        "\n"
        +
        "=" * 85
    )


    print(
        f"REPEAT {repeat_number}"
        f" | FOLD {fold_number}"
    )


    print(
        f"Model seed = {model_seed}"
    )


    print(
        "=" * 85
    )



    # ========================================================
    # 10-2. Validation groups
    # ========================================================

    val_group_ids = set(

        fold_groups[
            fold_number
        ]
    )


    # --------------------------------------------------------
    # Validation：
    # 該 fold 的 8 groups
    # --------------------------------------------------------

    val_df = (

        train_df[

            train_df[
                "group_id"
            ]
            .isin(
                val_group_ids
            )
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    # --------------------------------------------------------
    # Training：
    # 其他 32 groups
    # --------------------------------------------------------

    internal_train_df = (

        train_df[

            ~

            train_df[
                "group_id"
            ]
            .isin(
                val_group_ids
            )
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    # ========================================================
    # 10-3. Split QC
    # ========================================================

    assert len(
        internal_train_df
    ) == 96


    assert len(
        val_df
    ) == 24


    assert (
        internal_train_df[
            "group_id"
        ]
        .nunique()
        ==
        32
    )


    assert (
        val_df[
            "group_id"
        ]
        .nunique()
        ==
        8
    )


    # --------------------------------------------------------
    # Train：
    # 32 cases
    # 64 controls
    # --------------------------------------------------------

    assert (

        internal_train_df[
            "label"
        ]
        .value_counts()
        .to_dict()

        ==
        {
            0: 64,
            1: 32
        }
    )


    # --------------------------------------------------------
    # Validation：
    # 8 cases
    # 16 controls
    # --------------------------------------------------------

    assert (

        val_df[
            "label"
        ]
        .value_counts()
        .to_dict()

        ==
        {
            0: 16,
            1: 8
        }
    )


    # --------------------------------------------------------
    # Group leakage
    # --------------------------------------------------------

    assert set(

        internal_train_df[
            "group_id"
        ]

    ).isdisjoint(

        set(
            val_df[
                "group_id"
            ]
        )
    )


    print(
        "Train = 96 | Validation = 24"
    )



    # ========================================================
    # 10-4. DataLoader
    # ========================================================

    (
        train_dataset,
        val_dataset,
        dummy_test_dataset,

        train_loader,
        val_loader,
        dummy_test_loader

    ) = build_final_dataloaders(

        train_df=
            internal_train_df,

        val_df=
            val_df,

        # ----------------------------------------------------
        # Outer Test 30 完全沒有放進來。
        #
        # 這只是因為 helper function
        # 要求 test_df。
        # ----------------------------------------------------

        test_df=
            val_df.copy(),

        run_seed=
            model_seed,

        batch_size=
            BATCH_SIZE
    )



    # ========================================================
    # 10-5. V6
    # ========================================================

    model = build_exp1_v6_model(

        seed=
            model_seed,

        device=
            device,

        dropout_rate=
            DROPOUT_RATE
    )


    assert isinstance(

        model.maxpool,

        nn.Identity
    )



    # ========================================================
    # 10-6. Loss + Optimizer
    # ========================================================

    (
        criterion,
        optimizer,
        pos_weight_value

    ) = build_training_objects(

        model=
            model,

        train_df=
            internal_train_df,

        device=
            device,

        learning_rate=
            LEARNING_RATE,

        weight_decay=
            WEIGHT_DECAY
    )


    # --------------------------------------------------------
    # 應該仍然 = 2
    # --------------------------------------------------------

    assert np.isclose(

        float(
            pos_weight_value
        ),

        2.0
    )



    # ========================================================
    # 10-7. Scheduler
    # ========================================================

    scheduler = (

        torch.optim.lr_scheduler
        .ReduceLROnPlateau(

            optimizer,

            mode="max",

            factor=
                LR_FACTOR,

            patience=
                LR_PATIENCE,

            min_lr=
                MIN_LEARNING_RATE
        )
    )



    # ========================================================
    # 10-8. Best Model Tracking
    # ========================================================

    best_val_auc = -np.inf

    best_val_loss = np.inf

    best_epoch = 0

    best_model_state = None

    epochs_without_improvement = 0



    # ========================================================
    # 10-9. Training
    # ========================================================

    for epoch in range(

        1,

        MAX_EPOCHS + 1
    ):


        train_result = train_one_epoch(

            model=
                model,

            data_loader=
                train_loader,

            criterion=
                criterion,

            optimizer=
                optimizer,

            device=
                device
        )


        (
            val_result,
            val_labels,
            val_probs,
            val_ids

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device
        )


        current_lr = (

            optimizer
            .param_groups[0][
                "lr"
            ]
        )


        # ====================================================
        # Best epoch selection
        # ====================================================

        auc_improved = (

            val_result[
                "auc"
            ]

            >

            best_val_auc
            +
            1e-8
        )


        auc_tied_loss_improved = (

            abs(

                val_result[
                    "auc"
                ]

                -

                best_val_auc
            )

            <=
            1e-8

            and

            val_result[
                "loss"
            ]

            <

            best_val_loss
        )


        is_best = (

            auc_improved

            or

            auc_tied_loss_improved
        )


        if is_best:


            best_val_auc = (

                val_result[
                    "auc"
                ]
            )


            best_val_loss = (

                val_result[
                    "loss"
                ]
            )


            best_epoch = epoch


            best_model_state = {

                key:

                    value
                    .detach()
                    .cpu()
                    .clone()

                for key, value
                in model
                .state_dict()
                .items()
            }


            epochs_without_improvement = 0


        else:


            epochs_without_improvement += 1


        scheduler.step(

            val_result[
                "auc"
            ]
        )


        print(

            f"Epoch {epoch:02d}"

            f" | LR {current_lr:.2e}"

            f" | Train AUC "
            f"{train_result['auc']:.3f}"

            f" | Val AUC "
            f"{val_result['auc']:.3f}"

            f" | Val SD "
            f"{val_result['prob_sd']:.6f}"

            f" | Best "
            f"{best_epoch}"
        )


        if (

            epochs_without_improvement

            >=

            EARLY_STOPPING_PATIENCE
        ):


            print(
                "Early stopping."
            )


            break



    # ========================================================
    # 10-10. Restore Best Checkpoint
    # ========================================================

    assert best_model_state is not None


    model.load_state_dict(

        best_model_state
    )


    model = model.to(
        device
    )


    model.eval()



    # ========================================================
    # 10-11. Best Model → Training Evaluation
    # ========================================================

    (
        best_train_result,
        train_labels,
        train_probs,
        train_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            train_loader,

        criterion=
            criterion,

        device=
            device
    )



    # ========================================================
    # 10-12. Best Model → Validation OOF Evaluation
    # ========================================================

    (
        best_val_result,
        val_labels,
        val_probs,
        val_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            val_loader,

        criterion=
            criterion,

        device=
            device
    )



    # ========================================================
    # 10-13. 整理 Validation OOF
    # ========================================================

    val_labels = (

        np.asarray(
            val_labels
        )

        .reshape(
            -1
        )

        .astype(
            int
        )
    )


    val_probs = (

        np.asarray(
            val_probs
        )

        .reshape(
            -1
        )

        .astype(
            float
        )
    )


    val_ids = list(
        val_ids
    )


    oof_df = pd.DataFrame(
        {

            "repeat":
                repeat_number,

            "cv_fold":
                fold_number,

            "psam_IID":
                val_ids,

            "true_label":
                val_labels,

            "oof_probability":
                val_probs
        }
    )



    # ========================================================
    # 10-14. Within-fold Standardization
    # ========================================================

    fold_prob_mean = (

        oof_df[
            "oof_probability"
        ]
        .mean()
    )


    fold_prob_sd = (

        oof_df[
            "oof_probability"
        ]
        .std(
            ddof=1
        )
    )


    assert (
        fold_prob_sd
        >
        0
    )


    # --------------------------------------------------------
    # Centered score
    # --------------------------------------------------------

    oof_df[
        "centered_score"
    ] = (

        oof_df[
            "oof_probability"
        ]

        -

        fold_prob_mean
    )


    # --------------------------------------------------------
    # Z-score
    # --------------------------------------------------------

    oof_df[
        "z_score"
    ] = (

        oof_df[
            "centered_score"
        ]

        /

        fold_prob_sd
    )


    # --------------------------------------------------------
    # Percentile rank
    # --------------------------------------------------------

    oof_df[
        "percentile_rank"
    ] = (

        oof_df[
            "oof_probability"
        ]

        .rank(

            method="average",

            pct=True
        )
    )



    # ========================================================
    # 10-15. Case-Control Relative Difference
    # ========================================================

    case_z_mean = (

        oof_df.loc[

            oof_df[
                "true_label"
            ]
            ==
            1,

            "z_score"
        ]

        .mean()
    )


    control_z_mean = (

        oof_df.loc[

            oof_df[
                "true_label"
            ]
            ==
            0,

            "z_score"
        ]

        .mean()
    )


    case_minus_control_z = (

        case_z_mean

        -

        control_z_mean
    )



    # ========================================================
    # 10-16. Fold AUC
    # ========================================================

    fold_val_auc = roc_auc_score(

        oof_df[
            "true_label"
        ],

        oof_df[
            "oof_probability"
        ]
    )


    # --------------------------------------------------------
    # AUC 不受 centered / Z-score 影響，
    # 因為這些都是單調線性轉換。
    # --------------------------------------------------------



    # ========================================================
    # 10-17. Generalization Gap
    # ========================================================

    train_auc = float(

        best_train_result[
            "auc"
        ]
    )


    val_auc = float(
        fold_val_auc
    )


    auc_gap = (

        train_auc

        -

        val_auc
    )



    # ========================================================
    # 10-18. Fold Summary
    # ========================================================

    fold_summary = {

        "repeat":
            repeat_number,

        "fold":
            fold_number,

        "model_seed":
            model_seed,

        "best_epoch":
            best_epoch,

        "train_auc":
            train_auc,

        "val_auc":
            val_auc,

        "auc_gap":
            auc_gap,

        "train_prob_mean":
            float(
                best_train_result[
                    "prob_mean"
                ]
            ),

        "train_prob_sd":
            float(
                best_train_result[
                    "prob_sd"
                ]
            ),

        "val_prob_mean":
            float(
                fold_prob_mean
            ),

        "val_prob_sd":
            float(
                fold_prob_sd
            ),

        "case_z_mean":
            float(
                case_z_mean
            ),

        "control_z_mean":
            float(
                control_z_mean
            ),

        "case_minus_control_z":
            float(
                case_minus_control_z
            ),

        "positive_direction":
            bool(
                case_minus_control_z
                >
                0
            ),

        "auc_above_0_5":
            bool(
                val_auc
                >
                0.5
            )
    }



    print(
        "\n"
        +
        "-" * 85
    )


    print(
        f"Repeat {repeat_number}"
        f" | Fold {fold_number}"
        f" finished"
    )


    print(
        f"Best epoch = {best_epoch}"
    )


    print(
        f"Train AUC = "
        f"{train_auc:.4f}"
    )


    print(
        f"Validation AUC = "
        f"{val_auc:.4f}"
    )


    print(
        f"Train-Val gap = "
        f"{auc_gap:.4f}"
    )


    print(
        f"Case-Control Z difference = "
        f"{case_minus_control_z:.4f}"
    )


    print(
        f"Validation probability mean = "
        f"{fold_prob_mean:.6f}"
    )


    print(
        f"Validation probability SD = "
        f"{fold_prob_sd:.6f}"
    )


    print(
        "-" * 85
    )


    return {

        "summary":
            fold_summary,

        "oof":
            oof_df
    }




        # ----------------------------------------------------

        (
            val_result,
            val_labels,
            val_probs,
            val_ids

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device
        )



        current_lr = (

            optimizer
            .param_groups[0][
                "lr"
            ]
        )



        # ====================================================
        # Best epoch selection
        # ====================================================

        auc_improved = (

            val_result[
                "auc"
            ]

            >

            best_val_auc
            +
            1e-8
        )


        auc_tied_loss_improved = (

            abs(

                val_result[
                    "auc"
                ]

                -

                best_val_auc
            )

            <=
            1e-8

            and

            val_result[
                "loss"
            ]

            <

            best_val_loss
        )


        is_best = (

            auc_improved
            or
            auc_tied_loss_improved
        )



        # ====================================================
        # Save best checkpoint
        # ====================================================

        if is_best:


            best_val_auc = (

                val_result[
                    "auc"
                ]
            )


            best_val_loss = (

                val_result[
                    "loss"
                ]
            )


            best_epoch = epoch


            best_model_state = {

                key:

                    value
                    .detach()
                    .cpu()
                    .clone()

                for key, value
                in model
                .state_dict()
                .items()
            }


            epochs_without_improvement = 0


        else:


            epochs_without_improvement += 1



        # ====================================================
        # Scheduler
        # ====================================================

        scheduler.step(

            val_result[
                "auc"
            ]
        )



        # ====================================================
        # Print
        # ====================================================

        print(

            f"Epoch {epoch:02d}"

            f" | LR {current_lr:.2e}"

            f" | Train AUC "
            f"{train_result['auc']:.3f}"

            f" | Val AUC "

    # ========================================================

    internal_train_df = (

        exp1_train_df[

            exp1_train_df[
                "cv_fold"
            ]
            !=
            fold_number

        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    internal_val_df = (

        exp1_train_df[

            exp1_train_df[
                "cv_fold"
            ]

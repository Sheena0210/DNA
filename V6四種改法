# 6. 找每個 Fold 的 Primary Optimal Threshold
# ============================================================

# Primary rule：
#
# 1.
# min |Sensitivity - Specificity|
#
# 2.
# 如果 gap 相同：
# max Balanced Accuracy
#
# 3.
# 如果仍相同：
# max Youden J
# ============================================================


primary_optimal_rows = []


for fold_number in range(

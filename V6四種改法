# 自己 fold 的 SD
# ------------------------------------------------------------



# ============================================================
# 6. Method 1：
# Fold-centered score
# ============================================================

exp1_v6_scale_diag[
    "centered_score"
] = (

    exp1_v6_scale_diag[
        "oof_probability"
    ]

    -

    exp1_v6_scale_diag[
        "fold_prob_mean"
    ]
)


# ------------------------------------------------------------
# 公式：
#
# centered_score
#
# =
#
# 個人的 probability
# -
# 該 fold 的平均 probability
#
#
# 例如 Fold 1：
#
# Fold mean = 0.3920
#
# Case probability = 0.3925
#
# centered score =
#
# 0.3925 - 0.3920
#
# = +0.0005
#
#
# 正值：
# 比自己 fold 平均高
#
# 負值：
# 比自己 fold 平均低
#
#
# 這樣就先把：
#
# Fold 1 喜歡輸出 0.39
# Fold 5 喜歡輸出 0.82
#
# 這個 baseline difference 移除。
# ------------------------------------------------------------



# ============================================================
# 7. Method 2：
# Within-fold Z-score
# ============================================================

assert (

    exp1_v6_scale_diag[
        "fold_prob_sd"
    ]
    >
    0

).all()


exp1_v6_scale_diag[
    "z_score"
] = (

    (
        exp1_v6_scale_diag[
            "oof_probability"
        ]

        -

        exp1_v6_scale_diag[
            "fold_prob_mean"
        ]
    )

    /

    exp1_v6_scale_diag[
        "fold_prob_sd"
    ]
)


# ------------------------------------------------------------
# 公式：
#
# z =
#
# (p - fold mean)
# ----------------
#    fold SD
#
#
# 解釋：
#
# z = +1
#
# 表示這個人的 probability
# 比自己 fold 平均高 1 個 SD。
#
#
# z = -1
#
# 表示比自己 fold 平均低 1 個 SD。
#
#
# 這樣除了移除 mean 差異，
# 也把不同 fold 的 probability spread 標準化。
# ------------------------------------------------------------



# ============================================================
# 8. Method 3：
# Within-fold Percentile Rank
# ============================================================

exp1_v6_scale_diag[
    "percentile_rank"
] = (

    exp1_v6_scale_diag

    .groupby(
        "cv_fold"
    )

    [
        "oof_probability"
    ]

    .rank(

        method="average",

        pct=True
    )
)


# ------------------------------------------------------------
# percentile rank 完全不管 absolute probability。
#
# 只問：
#
# 「這個人在自己 fold 裡排第幾？」
#
#
# 例如：
#
# percentile = 0.90
#
# 表示他的 probability
# 比同 fold 約 90% 的人高。
#
#
# 這是最直接檢查 ranking signal 的方法之一。
# ------------------------------------------------------------




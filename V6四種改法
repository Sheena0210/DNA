# ============================================================
# 8. 建立一個 Repeat 的 5-fold 分組
# ============================================================

def create_repeated_cv_folds(
    train_df,
    repeat_number,
    split_seed
):


    all_groups = sorted(

        train_df[
            "group_id"
        ]
        .unique()
    )


    assert len(
        all_groups
    ) == 40


    assert 2 in all_groups

    assert 34 in all_groups


    # --------------------------------------------------------
    # 先把 related groups 2、34 拿掉
    # --------------------------------------------------------

    remaining_groups = [

        g

        for g in all_groups

        if g not in RELATED_BLOCK
    ]


    assert len(
        remaining_groups
    ) == 38


    # --------------------------------------------------------
    # 每一 repeat 使用不同 split seed
    # --------------------------------------------------------

    current_split_seed = (

        split_seed
        +
        repeat_number
    )


    rng = np.random.default_rng(

        current_split_seed
    )


    rng.shuffle(

        remaining_groups
    )


    # --------------------------------------------------------
    # 隨機決定：
    #
    # group 2 + group 34
    #
    # 要放在哪一個 fold。
    #
    # 避免每次永遠都叫 Fold 1。
    # --------------------------------------------------------

    related_fold = int(

        rng.integers(
            1,
            6
        )
    )


    fold_groups = {

        1: [],
        2: [],
        3: [],
        4: [],
        5: []
    }


    # --------------------------------------------------------
    # related fold：
    #
    # 2 related groups
    # +
    # 6 normal groups
    #
    # = 8 groups
    # --------------------------------------------------------

    fold_groups[
        related_fold
    ] = (

        RELATED_BLOCK
        +
        remaining_groups[
            0:6
        ]
    )


    # --------------------------------------------------------
    # 剩下：
    #
    # 38 - 6 = 32 groups
    #
    # 分給另外 4 folds
    #
    # 每 fold 8 groups
    # --------------------------------------------------------

    remaining_after_related = (

        remaining_groups[
            6:
        ]
    )


    other_folds = [

        f

        for f in range(
            1,
            6
        )

        if f != related_fold
    ]


    start = 0


    for fold_number in other_folds:


        fold_groups[
            fold_number
        ] = (

            remaining_after_related[
                start:
                start + 8
            ]
        )


        start += 8


    # ========================================================
    # Split QC
    # ========================================================

    all_assigned_groups = [

        g

        for groups
        in fold_groups.values()

        for g
        in groups
    ]


    assert len(
        all_assigned_groups
    ) == 40


    assert len(
        set(
            all_assigned_groups
        )
    ) == 40


    assert (
        set(
            all_assigned_groups
        )
        ==
        set(
            all_groups
        )
    )


    for fold_number in range(
        1,
        6
    ):


        assert len(

            fold_groups[
                fold_number
            ]

        ) == 8


    # --------------------------------------------------------
    # group 2 / 34 必須在同一 fold
    # --------------------------------------------------------

    fold_of_2 = [

        f

        for f, groups
        in fold_groups.items()

        if 2 in groups
    ][0]


    fold_of_34 = [

        f

        for f, groups
        in fold_groups.items()

        if 34 in groups
    ][0]


    assert (
        fold_of_2
        ==
        fold_of_34
    )


    return (
        fold_groups,
        current_split_seed,
        related_fold
    )




# ============================================================
# 13. Matched-group Bootstrap
#
# 目的：
#
# 檢查：
#
# 如果 40 個 matched groups 有些 sampling variability，
# optimal threshold 會不會大幅改變？
#
#
# 注意：
#
# Bootstrap 是以 group_id 為單位抽樣，
# 不是以 subject 個別抽樣。
# ============================================================

N_BOOTSTRAPS = 1000

BOOTSTRAP_SEED = 20261001


rng = np.random.default_rng(

    BOOTSTRAP_SEED
)


unique_groups = np.sort(

    subject_score[
        "group_id"
    ]
    .unique()
)


assert len(
    unique_groups
) == 40


bootstrap_results = []


for bootstrap_id in range(

    1,

    N_BOOTSTRAPS + 1
):


    # --------------------------------------------------------
    # 從 40 matched groups 中
    # 有放回抽 40 groups。
    # --------------------------------------------------------

    sampled_groups = rng.choice(

        unique_groups,

        size=
            len(
                unique_groups
            ),

        replace=True
    )


    bootstrap_parts = []


    for bootstrap_group_index, group_id in enumerate(

        sampled_groups
    ):


        group_df = (

            subject_score[

                subject_score[
                    "group_id"
                ]
                ==
                group_id
            ]

            .copy()
        )


        # ----------------------------------------------------
        # 同一 group 若被 bootstrap 抽到多次，
        # 必須保留重複。
        # ----------------------------------------------------

        group_df[
            "bootstrap_group_index"
        ] = bootstrap_group_index


        bootstrap_parts.append(

            group_df
        )


    bootstrap_df = pd.concat(

        bootstrap_parts,

        ignore_index=True
    )


    bootstrap_scores = (

        bootstrap_df[
            "mean_trainref_z"
        ]
        .to_numpy()
    )


    bootstrap_labels = (

        bootstrap_df[
            "true_label"
        ]
        .to_numpy()
    )


    bootstrap_candidates = (

        create_threshold_candidates(

            bootstrap_scores
        )
    )


    bootstrap_scan_rows = []


    for threshold in bootstrap_candidates:


        result = calculate_threshold_metrics(

            labels=
                bootstrap_labels,

            scores=
                bootstrap_scores,

            threshold=
                threshold
        )


        bootstrap_scan_rows.append(

            result
        )


    bootstrap_scan = pd.DataFrame(

        bootstrap_scan_rows
    )


    # --------------------------------------------------------
    # 同樣使用：
    #
    # Max BA
    # → Min gap
    # → middle threshold
    # --------------------------------------------------------

    bootstrap_max_ba = (

        bootstrap_scan[
            "balanced_accuracy"
        ]
        .max()
    )


    bootstrap_best = (

        bootstrap_scan[

            np.isclose(

                bootstrap_scan[
                    "balanced_accuracy"
                ],

                bootstrap_max_ba
            )
        ]

        .copy()
    )


    bootstrap_min_gap = (

        bootstrap_best[
            "sens_spec_gap"
        ]
        .min()
    )


    bootstrap_best = (

        bootstrap_best[

            np.isclose(

                bootstrap_best[
                    "sens_spec_gap"
                ],

                bootstrap_min_gap
            )
        ]

        .sort_values(
            "threshold"
        )

        .reset_index(
            drop=True
        )
    )


    bootstrap_middle_index = (

        len(
            bootstrap_best
        )
        //
        2
    )


    bootstrap_selected = (

        bootstrap_best

        .iloc[
            bootstrap_middle_index
        ]
    )


    bootstrap_results.append(
        {

            "bootstrap_id":
                bootstrap_id,

            "threshold":
                bootstrap_selected[
                    "threshold"
                ],

            "sensitivity":
                bootstrap_selected[
                    "sensitivity"
                ],

            "specificity":
                bootstrap_selected[
                    "specificity"
                ],

            "balanced_accuracy":
                bootstrap_selected[
                    "balanced_accuracy"
                ],

            "sens_spec_gap":
                bootstrap_selected[
                    "sens_spec_gap"
                ],

            "PPV":
                bootstrap_selected[
                    "PPV"
                ],

            "NPV":
                bootstrap_selected[
                    "NPV"
                ]
        }
    )



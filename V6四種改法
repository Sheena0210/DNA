# Matched-set loss

# Matched-set loss
# 每個 matched group = 1 Case + 2 Controls
def matched_set_loss(logits, labels, group_ids):
    logits = logits.view(-1)
    # 將 logits 統一整理成一維：
    # [batch_size, 1] → [batch_size]
    labels = labels.view(-1)


    # group_ids:
    # 每個 subject 所屬的 matched group ID。
    #
    # 例如：
    # group_ids = [101, 101, 101, 102, 102, 102]
    #
    # 表示：
    # Group 101 = 第 1~3 人
    # Group 102 = 第 4~6 人

    group_ids = group_ids.view(-1)


    # 找出這個 batch 中有哪些不同的 matched groups。
    #
    # 上面的例子會得到：
    # unique_groups = [101, 102]

    unique_groups = torch.unique(group_ids)


    # 用來儲存每一個 matched group 算出的 loss。

    group_losses = []


    # --------------------------------------------------------
    # 一次處理一個 matched group
    # --------------------------------------------------------

    for g in unique_groups:

        # 找出目前這個 matched group 的所有 subjects。
        #
        # 假設 g = 101：
        # mask = [True, True, True, False, False, False]

        mask = (group_ids == g)


        # 取出這個 matched group 三個人的 CNN logits。
        #
        # 例如：
        # group_logits = [1.2, 0.3, -0.4]

        group_logits = logits[mask]


        # 取出這三個人的真實 label。
        #
        # 例如：
        # group_labels = [1, 0, 0]

        group_labels = labels[mask]


        # ----------------------------------------------------
        # QC 1：
        # 目前研究設計固定每組為 1 Case + 2 Controls，
        # 因此每一個 matched group 必須剛好有 3 個 subjects。
        # ----------------------------------------------------

        if group_logits.numel() != 3:
            raise ValueError(
                f"Matched group {g.item()} has "
                f"{group_logits.numel()} subjects; expected 3."
            )


        # ----------------------------------------------------
        # QC 2：
        # 每組必須剛好有一個 Case。
        #
        # 因為 label：
        # Case = 1
        # Control = 0
        #
        # 所以 labels 加總應該等於 1。
        # ----------------------------------------------------

        if group_labels.sum().item() != 1:
            raise ValueError(
                f"Matched group {g.item()} does not contain "
                f"exactly one case."
            )


        # 找到 Case 在這個 matched group 中的位置。
        #
        # 如果：
        # group_labels = [0, 1, 0]
        #
        # 則 case_index = 1

        case_index = torch.where(group_labels == 1)[0].item()


        # 取得 Case 的 raw logit。
        #
        # 假設：
        # group_logits = [0.3, 1.2, -0.4]
        #
        # case_index = 1
        #
        # 則：
        # case_logit = 1.2

        case_logit = group_logits[case_index]


        # ----------------------------------------------------
        # 計算這一個 matched group 的 loss
        #
        # Loss_g =
        # -s_case + log(
        #     exp(s_case)
        #     + exp(s_control1)
        #     + exp(s_control2)
        # )
        #
        # 使用 torch.logsumexp()，
        # 而不是自己寫 log(exp(...)+exp(...))，
        # 是因為 logsumexp 在數值計算上較穩定。
        # ----------------------------------------------------

        loss_g = (
            -case_logit
            + torch.logsumexp(group_logits, dim=0)
        )


        # 把這一組的 loss 存起來。

        group_losses.append(loss_g)


    # --------------------------------------------------------
    # 將所有 matched groups 的 loss 取平均。
    #
    # 如果一個 batch 有 G 個 matched groups：
    #
    # Loss = (Loss_1 + Loss_2 + ... + Loss_G) / G
    # --------------------------------------------------------

    loss = torch.stack(group_losses).mean()


    return loss

#原本 V6：
#
#   每一位 subject 獨立計算 weighted BCE
#
#       Case    → 希望 probability → 1
#       Control → 希望 probability → 0
#
#
# Experiment 3：
#
#   每一個 matched set = 1 Case + 2 Controls
#
#   CNN 對三個人分別產生 raw logits：
#
#       s_case
#       s_control1
#       s_control2
#
#   定義：
#
#                         exp(s_case)

# ============================================================
# STEP 8
# Local-stem BasicBlock
#
# 特別設計：
#
# Layer1 Block1:
#
# 64 → 64
# stride = 2
#
# main branch:
#   Conv3×3 stride2
#
# shortcut:
#   AvgPool2d stride2
#
#
# 使用 AvgPool shortcut 的原因：
#
# - 不增加新的 Conv parameters
# - 不增加新的 GroupNorm
# - 保持 architecture capacity
#   幾乎等於原始 V6
# ============================================================

class V6LocalStemBasicBlock(
    nn.Module
):


    expansion = 1


    def __init__(
        self,
        in_channels,
        out_channels,
        stride=1,
        num_groups=32
    ):


        super().__init__()



        # ====================================================
        # Main branch - Conv 1
        # ====================================================

        self.conv1 = nn.Conv2d(

            in_channels=
                in_channels,

            out_channels=
                out_channels,

            kernel_size=3,

            stride=
                stride,

            padding=1,

            bias=False
        )



        self.norm1 = nn.GroupNorm(

            num_groups=
                num_groups,

            num_channels=
                out_channels
        )



        self.relu = nn.ReLU(

            inplace=True
        )



        # ====================================================
        # Main branch - Conv 2
        # ====================================================

        self.conv2 = nn.Conv2d(

            in_channels=
                out_channels,

            out_channels=
                out_channels,

            kernel_size=3,

            stride=1,

            padding=1,

            bias=False
        )



        self.norm2 = nn.GroupNorm(

            num_groups=
                num_groups,

            num_channels=
                out_channels
        )



        # ====================================================
        # Shortcut
        # ====================================================


        # ----------------------------------------------------
        # Special case:
        #
        # Same channels
        # but spatial downsampling needed.
        #
        # Example:
        #
        # Layer1 Block1
        #
        # 64×720×720
        #
        # →
        #
        # 64×360×360
        #
        # 用 parameter-free AvgPool。
        # ----------------------------------------------------

        if (

            stride != 1

            and

            in_channels
            ==
            out_channels
        ):


            self.downsample = nn.AvgPool2d(

                kernel_size=2,

                stride=2
            )



        # ----------------------------------------------------
        # Standard ResNet stage transition
        #
        # 64→128
        # 128→256
        # 256→512
        #
        # 使用原本的：
        #
        # 1×1 Conv + GroupNorm
        # ----------------------------------------------------

        elif (

            stride != 1

            or

            in_channels
            !=
            out_channels
        ):


            self.downsample = nn.Sequential(


                nn.Conv2d(

                    in_channels=
                        in_channels,

                    out_channels=
                        out_channels,

                    kernel_size=1,

                    stride=
                        stride,

                    bias=False
                ),


                nn.GroupNorm(

                    num_groups=
                        num_groups,

                    num_channels=
                        out_channels
                )
            )



        # ----------------------------------------------------
        # No transformation
        # ----------------------------------------------------

        else:


            self.downsample = nn.Identity()



    # ========================================================
    # Forward
    # ========================================================

    def forward(
        self,
        x
    ):


        identity = x



        # ----------------------------------------------------
        # Main branch
        # ----------------------------------------------------

        out = self.conv1(
            x
        )


        out = self.norm1(
            out
        )


        out = self.relu(
            out
        )


        out = self.conv2(
            out
        )


        out = self.norm2(
            out
        )



        # ----------------------------------------------------
        # Shortcut
        # ----------------------------------------------------

        identity = self.downsample(
            identity
        )



        # ----------------------------------------------------
        # Residual addition
        # ----------------------------------------------------

        out = (

            out
            +
            identity
        )


        out = self.relu(
            out
        )


        return out



# ============================================================
# STEP 9
# V6 + Local Stem
#
#
# Original V6:
#
# stem:
#
#   Conv7×7 s2
#
# layer1:
#
#   Block1 s1
#   Block2 s1
#
#
# Experiment 5:
#
# stem:
#
#   Conv3×3 s1
#
# layer1:
#
#   Block1 s2
#   Block2 s1
#
#
# 所以：
#
# Original:
#
# 720
# ↓ stem
# 360
# ↓ layer1
# 360
#
#
# Local Stem:
#
# 720
# ↓ stem
# 720
# ↓ layer1 block1
# 360
# ↓ layer1 block2
# 360
#
#
# Layer1結束後尺寸重新相同。
# ============================================================

class V6LocalStemResNet18(
    nn.Module
):


    def __init__(
        self,
        dropout_rate=0.5,
        num_groups=32
    ):


        super().__init__()


        self.num_groups = (
            num_groups
        )



        # ====================================================
        # LOCAL STEM
        #
        # Original:
        #
        # 7×7 stride2
        #
        # Experiment 5:
        #
        # 3×3 stride1
        # ====================================================

        self.conv1 = nn.Conv2d(

            in_channels=3,

            out_channels=64,

            kernel_size=3,

            stride=1,

            padding=1,

            bias=False
        )



        self.norm1 = nn.GroupNorm(

            num_groups=
                num_groups,

            num_channels=64
        )



        self.relu = nn.ReLU(

            inplace=True
        )



        # ====================================================
        # NO initial MaxPool
        #
        # 保持原始 V6。
        # ====================================================

        self.maxpool = nn.Identity()



        # ====================================================
        # Layer 1
        #
        # 第一個 block 做第一次 downsampling
        #
        # 720 → 360
        # ====================================================

        self.layer1 = self._make_layer(

            in_channels=64,

            out_channels=64,

            n_blocks=2,

            first_stride=2
        )



        # ====================================================
        # Layer 2
        #
        # 360 → 180
        # ====================================================

        self.layer2 = self._make_layer(

            in_channels=64,

            out_channels=128,

            n_blocks=2,

            first_stride=2
        )



        # ====================================================
        # Layer 3
        #
        # 180 → 90
        # ====================================================

        self.layer3 = self._make_layer(

            in_channels=128,

            out_channels=256,

            n_blocks=2,

            first_stride=2
        )



        # ====================================================
        # Layer 4
        #
        # 90 → 45
        # ====================================================

        self.layer4 = self._make_layer(

            in_channels=256,

            out_channels=512,

            n_blocks=2,

            first_stride=2
        )



        # ====================================================
        # Global Average Pooling
        #
        # Same as V6
        # ====================================================

        self.avgpool = nn.AdaptiveAvgPool2d(

            output_size=(
                1,
                1
            )
        )



        # ====================================================
        # Classifier
        #
        # Same as original V6
        #
        # 512 → 1
        # ====================================================

        self.fc = nn.Sequential(


            nn.Dropout(

                p=
                    dropout_rate
            ),


            nn.Linear(

                in_features=512,

                out_features=1
            )
        )



        # ====================================================
        # Initialization
        # ====================================================

        for module in self.modules():


            if isinstance(
                module,
                nn.Conv2d
            ):


                nn.init.kaiming_normal_(

                    module.weight,

                    mode="fan_out",

                    nonlinearity="relu"
                )


            elif isinstance(
                module,
                nn.GroupNorm
            ):


                nn.init.constant_(

                    module.weight,
                    1
                )


                nn.init.constant_(

                    module.bias,
                    0
                )



    # ========================================================
    # Stage builder
    # ========================================================

    def _make_layer(
        self,
        in_channels,
        out_channels,
        n_blocks,
        first_stride
    ):


        blocks = []



        # ----------------------------------------------------
        # First block
        # ----------------------------------------------------

        blocks.append(

            V6LocalStemBasicBlock(

                in_channels=
                    in_channels,

                out_channels=
                    out_channels,

                stride=
                    first_stride,

                num_groups=
                    self.num_groups
            )
        )



        # ----------------------------------------------------
        # Remaining block
        # ----------------------------------------------------

        for _ in range(
            1,
            n_blocks
        ):


            blocks.append(

                V6LocalStemBasicBlock(

                    in_channels=
                        out_channels,

                    out_channels=
                        out_channels,

                    stride=1,

                    num_groups=
                        self.num_groups
                )
            )



        return nn.Sequential(

            *blocks
        )



    # ========================================================
    # Forward
    # ========================================================

    def forward(
        self,
        x
    ):


        # ----------------------------------------------------
        # Local Stem
        #
        # 720 → 720
        # ----------------------------------------------------

        x = self.conv1(
            x
        )


        x = self.norm1(
            x
        )


        x = self.relu(
            x
        )


        x = self.maxpool(
            x
        )



        # ----------------------------------------------------
        # Layer1
        #
        # 720 → 360
        # ----------------------------------------------------

        x = self.layer1(
            x
        )



        # ----------------------------------------------------
        # Layer2
        #
        # 360 → 180
        # ----------------------------------------------------

        x = self.layer2(
            x
        )



        # ----------------------------------------------------
        # Layer3
        #
        # 180 → 90
        # ----------------------------------------------------

        x = self.layer3(
            x
        )



        # ----------------------------------------------------
        # Layer4
        #
        # 90 → 45
        # ----------------------------------------------------

        x = self.layer4(
            x
        )



        # ----------------------------------------------------
        # GAP
        # ----------------------------------------------------

        x = self.avgpool(
            x
        )



        # ----------------------------------------------------
        # Flatten
        #
        # B×512×1×1
        #
        # →
        #
        # B×512
        # ----------------------------------------------------

        x = torch.flatten(

            x,

            start_dim=1
        )



        # ----------------------------------------------------
        # Dropout + Linear
        # ----------------------------------------------------

        x = self.fc(
            x
        )


        return x



# ============================================================
# STEP 10
# Model builder
# ============================================================

def build_v6_localstem_model(
    seed,
    device,
    dropout_rate=0.5
):


    set_localstem_seed(
        seed
    )


    model = V6LocalStemResNet18(

        dropout_rate=
            dropout_rate,

        num_groups=
            V6_GROUPS
    )


    model = model.to(
        device
    )


    return model




                    "repeat",
                    "cv_fold",
                    "psam_IID"
                ],

                keep="last"
            )

            .sort_values(
                [
                    "repeat",
                    "cv_fold",
                    "psam_IID"
                ]
            )

            .reset_index(
                drop=True
            )
        )



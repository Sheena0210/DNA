        ]
        .copy()
    )



    # --------------------------------------------------------
    # 第一順位：
    # Sensitivity / Specificity gap 最小
    # --------------------------------------------------------

    min_gap = (

        fold_result[
            "sens_spec_gap"
        ]
        .min()
    )


    candidates = (

        fold_result[

            np.isclose(

                fold_result[
                    "sens_spec_gap"
                ],

                min_gap
            )
        ]

        .copy()
    )



    # --------------------------------------------------------
    # 第二順位：
    # Balanced Accuracy 最大
    # --------------------------------------------------------

    max_balanced_acc = (

        candidates[
            "balanced_accuracy"
        ]
        .max()
    )


    candidates = (

        candidates[

            np.isclose(

                candidates[
                    "balanced_accuracy"
                ],

                max_balanced_acc
            )
        ]

        .copy()
    )



    # --------------------------------------------------------
    # 第三順位：
    # Youden J 最大
    # --------------------------------------------------------

    max_youden = (

        candidates[
            "youden_j"

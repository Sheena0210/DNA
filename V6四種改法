                    "psam_IID",
                    "group_id",
                    "label"
                ]
            ]

            .copy()
        )


        val_lookup[
            "psam_IID"
        ] = (

            val_lookup[
                "psam_IID"
            ]

            .astype(str)
        )


        val_lookup = (

            val_lookup

            .set_index(
                "psam_IID"
            )
        )



        train_lookup = (

            fold_train_df[
                [
                    "psam_IID",

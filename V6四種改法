    "Experiment4_V6_Small"
)


EXP4_CV_DIR = (

    EXP4_DIR
    /
    "Repeated_CV"
)


EXP4_CV_DIR.mkdir(

    parents=True,

    exist_ok=True
)



# ============================================================
# STEP 15
# Checkpoint files
# ============================================================

FOLD_CHECKPOINT_PATH = (

    EXP4_CV_DIR
    /
    "V6Small_fold_summary_checkpoint.csv"
)


OOF_CHECKPOINT_PATH = (

    EXP4_CV_DIR
    /
    "V6Small_OOF_checkpoint.csv"
)


TRAINREF_CHECKPOINT_PATH = (

    EXP4_CV_DIR
    /
    "V6Small_training_reference_checkpoint.csv"
)


HISTORY_CHECKPOINT_PATH = (

    EXP4_CV_DIR
    /
    "V6Small_history_checkpoint.csv"
)



# ============================================================
# STEP 16
# Hyperparameters
#
# SAME AS EXP1
# ============================================================

N_REPEATS = 5

N_FOLDS = 5


BATCH_SIZE = 2


DROPOUT_RATE = 0.5


LEARNING_RATE = 5e-5


WEIGHT_DECAY = 1e-3


MAX_EPOCHS = 30


EARLY_STOPPING_PATIENCE = 5


LR_PATIENCE = 2


LR_FACTOR = 0.5


MIN_LEARNING_RATE = 1e-6


MODEL_SEED_BASE = 20261000



# ============================================================
# STEP 17
# Resume existing Experiment 4 checkpoint
# ============================================================

if FOLD_CHECKPOINT_PATH.exists():


    fold_records = (

        pd.read_csv(
            FOLD_CHECKPOINT_PATH
        )

        .to_dict(
            orient="records"
        )
    )


else:


    fold_records = []



if OOF_CHECKPOINT_PATH.exists():


    oof_records = (

        pd.read_csv(
            OOF_CHECKPOINT_PATH
        )

        .to_dict(
            orient="records"
        )
    )


else:


    oof_records = []



if TRAINREF_CHECKPOINT_PATH.exists():


    trainref_records = (

        pd.read_csv(
            TRAINREF_CHECKPOINT_PATH
        )

        .to_dict(
            orient="records"
        )
    )


else:


    trainref_records = []



if HISTORY_CHECKPOINT_PATH.exists():


    history_records = (

        pd.read_csv(
            HISTORY_CHECKPOINT_PATH
        )

        .to_dict(
            orient="records"
        )
    )


else:


    history_records = []



completed_folds = set(


    (

        int(row["repeat"]),
        int(row["fold"])

    )

    for row
    in fold_records
)



print(
    "\nPreviously completed V6-Small folds =",
    len(
        completed_folds
    ),
    "/ 25"
)



# ============================================================
# STEP 18
# Repeated 5×5 CV
# ============================================================

for repeat_number in range(
    1,
    N_REPEATS + 1
):


    for fold_number in range(
        1,
        N_FOLDS + 1
    ):


        fold_key = (

            repeat_number,
            fold_number
        )



        # ----------------------------------------------------
        # Resume support
        # ----------------------------------------------------

        if fold_key in completed_folds:


            print(

                f"\nSKIP Repeat {repeat_number} "
                f"Fold {fold_number}"
            )


            continue



        # ====================================================
        # 18-1
        # SAME seed rule as Exp1
        # ====================================================

        model_seed = (

            MODEL_SEED_BASE

            +
            repeat_number * 100

            +
            fold_number
        )


        set_v6small_seed(

            model_seed
        )



        print(
            "\n"
            +
            "=" * 110
        )


        print(

            f"EXPERIMENT 4 | V6-SMALL | "
            f"REPEAT {repeat_number}/5 | "
            f"FOLD {fold_number}/5"
        )


        print(
            "Seed =",
            model_seed
        )


        print(
            "=" * 110
        )



        # ====================================================
        # 18-2
        # EXACT SAME Exp1 validation subjects
        # ====================================================

        val_ids = set(

            exp1_fold_assignment.loc[

                (
                    exp1_fold_assignment[
                        "repeat"
                    ]
                    ==
                    repeat_number
                )

                &

                (
                    exp1_fold_assignment[
                        "cv_fold"
                    ]
                    ==
                    fold_number
                ),

                "psam_IID"
            ]

            .astype(str)
        )


        assert len(
            val_ids
        ) == 24



        # ====================================================
        # 18-3
        # Fold Train96 / Val24
        # ====================================================

        fold_val_df = (

            exp1_train_df[

                exp1_train_df[
                    "psam_IID"
                ]

                .astype(str)

                .isin(
                    val_ids
                )
            ]

            .copy()

            .reset_index(
                drop=True
            )
        )


        fold_train_df = (

            exp1_train_df[

                ~

                exp1_train_df[
                    "psam_IID"
                ]

                .astype(str)

                .isin(
                    val_ids
                )
            ]

            .copy()

            .reset_index(
                drop=True
            )
        )



        assert len(
            fold_train_df
        ) == 96


        assert len(
            fold_val_df
        ) == 24


        assert (
            fold_train_df[
                "label"
            ]
            .sum()
            ==
            32
        )


        assert (
            fold_val_df[
                "label"
            ]
            .sum()
            ==
            8
        )



        # ====================================================
        # 18-4
        # Group leakage QC
        # ====================================================

        train_groups = set(

            fold_train_df[
                "group_id"
            ]
        )


        val_groups = set(

            fold_val_df[
                "group_id"
            ]
        )


        assert len(
            train_groups
        ) == 32


        assert len(
            val_groups
        ) == 8


        assert train_groups.isdisjoint(
            val_groups
        )



        # ----------------------------------------------------
        # Every matched group = 3 subjects
        # ----------------------------------------------------

        for df in [

            fold_train_df,
            fold_val_df

        ]:


            group_check = (

                df

                .groupby(
                    "group_id"
                )

                .agg(

                    n=(
                        "psam_IID",
                        "size"
                    ),

                    n_case=(
                        "label",
                        "sum"
                    )
                )
            )


            assert (
                group_check[
                    "n"
                ]
                ==
                3
            ).all()


            assert (
                group_check[
                    "n_case"
                ]
                ==
                1
            ).all()



        print(
            "Internal Train =",
            len(
                fold_train_df
            ),
            "| groups =",
            len(
                train_groups
            )
        )


        print(
            "Internal Validation =",
            len(
                fold_val_df
            ),
            "| groups =",
            len(
                val_groups
            )
        )


        print(
            "Matched-group leakage QC = PASSED"
        )



        # ====================================================
        # 18-5
        # DataLoaders
        #
        # train_df:
        #     Train96 with training transform
        #
        # val_df:
        #     Train96 again,
        #     but deterministic evaluation transform
        #
        # test_df:
        #     Validation24 deterministic transform
        #
        # This gives:
        #
        # train_loader
        # train_eval_loader
        # val_loader
        # ====================================================

        (

            train_dataset,
            train_eval_dataset,
            val_dataset,

            train_loader,
            train_eval_loader,
            val_loader

        ) = build_final_dataloaders(

            train_df=
                fold_train_df,

            val_df=
                fold_train_df,

            test_df=
                fold_val_df,

            run_seed=
                model_seed,

            batch_size=
                BATCH_SIZE
        )



        assert len(
            train_loader
        ) == 48


        assert len(
            val_loader
        ) == 12


        print(
            "Train batches =",
            len(
                train_loader
            )
        )


        print(
            "Validation batches =",
            len(
                val_loader
            )
        )



        # ====================================================
        # 18-6
        # Reset seed after DataLoader construction
        # ====================================================

        set_v6small_seed(

            model_seed
        )



        # ====================================================
        # 18-7
        # V6-Small
        # ====================================================

        model = build_v6_small_model(

            seed=
                model_seed,

            device=
                device_v6small,

            dropout_rate=
                DROPOUT_RATE
        )


        print(
            "Initial MaxPool =",
            model.maxpool
        )


        print(
            "Channels = "
            "32 / 64 / 128 / 256"
        )



        # ====================================================
        # 18-8
        # SAME weighted BCE + AdamW as Exp1
        # ====================================================

        (

            criterion,
            optimizer,
            pos_weight_value

        ) = build_training_objects(

            model=
                model,

            train_df=
                fold_train_df,

            device=
                device_v6small,

            learning_rate=
                LEARNING_RATE,

            weight_decay=
                WEIGHT_DECAY
        )



        if torch.is_tensor(
            pos_weight_value
        ):


            pos_weight_print = float(

                pos_weight_value

                .detach()

                .cpu()

                .item()
            )


        else:


            pos_weight_print = float(

                pos_weight_value
            )


        print(
            "Loss = Weighted BCEWithLogitsLoss"
        )


        print(
            "pos_weight =",
            pos_weight_print
        )


        print(
            "Optimizer =",
            optimizer.__class__.__name__
        )


        print(
            "LR =",
            LEARNING_RATE
        )


        print(
            "Weight decay =",
            WEIGHT_DECAY
        )



        # ====================================================
        # 18-9
        # SAME scheduler
        # ====================================================

        scheduler = (

            torch.optim.lr_scheduler
            .ReduceLROnPlateau(

                optimizer,

                mode="max",

                factor=
                    LR_FACTOR,

                patience=
                    LR_PATIENCE,

                min_lr=
                    MIN_LEARNING_RATE
            )
        )



        # ====================================================
        # 18-10
        # Best-model tracking
        # ====================================================

        best_val_auc = -np.inf

        best_val_loss = np.inf

        best_epoch = 0

        best_model_state = None

        epochs_without_improvement = 0



        # ====================================================
        # 18-11
        # Epoch loop
        # ====================================================

        for epoch in range(
            1,
            MAX_EPOCHS + 1
        ):


            # ------------------------------------------------
            # Training
            # ------------------------------------------------

            train_result = (

                train_one_epoch(

                    model=
                        model,

                    data_loader=
                        train_loader,

                    criterion=
                        criterion,

                    optimizer=
                        optimizer,

                    device=
                        device_v6small
                )
            )



            # ------------------------------------------------
            # Validation
            # ------------------------------------------------

            (

                val_result,
                _,
                _,
                _

            ) = evaluate_one_epoch(

                model=
                    model,

                data_loader=
                    val_loader,

                criterion=
                    criterion,

                device=
                    device_v6small
            )



            current_lr = (

                optimizer

                .param_groups[0][
                    "lr"
                ]
            )



            # =================================================
            # Save history
            # =================================================

            history_records.append(
                {

                    "repeat":
                        repeat_number,

                    "fold":
                        fold_number,

                    "seed":
                        model_seed,

                    "epoch":
                        epoch,

                    "learning_rate":
                        current_lr,

                    "train_loss":
                        train_result[
                            "loss"
                        ],

                    "train_auc":
                        train_result[
                            "auc"
                        ],

                    "train_prob_mean":
                        train_result[
                            "prob_mean"
                        ],

                    "train_prob_sd":
                        train_result[
                            "prob_sd"
                        ],

                    "val_loss":
                        val_result[
                            "loss"
                        ],

                    "val_auc":
                        val_result[
                            "auc"
                        ],

                    "val_prob_mean":
                        val_result[
                            "prob_mean"
                        ],

                    "val_prob_sd":
                        val_result[
                            "prob_sd"
                        ]
                }
            )



            # =================================================
            # Best epoch
            #
            # Primary:
            #
            # maximum Validation AUC
            #
            # Tie:
            #
            # lower Validation loss
            # =================================================

            auc_improved = (

                val_result[
                    "auc"
                ]

                >
                best_val_auc
                +
                1e-8
            )


            auc_tie_loss_improved = (

                abs(

                    val_result[
                        "auc"
                    ]

                    -
                    best_val_auc
                )

                <=
                1e-8

                and

                val_result[
                    "loss"
                ]

                <
                best_val_loss
            )


            is_best = (

                auc_improved

                or

                auc_tie_loss_improved
            )



            if is_best:


                best_val_auc = float(

                    val_result[
                        "auc"
                    ]
                )


                best_val_loss = float(

                    val_result[
                        "loss"
                    ]
                )


                best_epoch = int(
                    epoch
                )


                best_model_state = {

                    key:

                        value

                        .detach()

                        .cpu()

                        .clone()

                    for key, value

                    in model
                    .state_dict()
                    .items()
                }


                epochs_without_improvement = 0



            else:


                epochs_without_improvement += 1



            # =================================================
            # Scheduler
            # =================================================

            scheduler.step(

                val_result[
                    "auc"
                ]
            )



            # =================================================
            # Print
            # =================================================

            print(

                f"Epoch {epoch:02d}"

                f" | LR {current_lr:.2e}"

                f" | Train loss "
                f"{train_result['loss']:.4f}"

                f" | Train AUC "
                f"{train_result['auc']:.3f}"

                f" | Val loss "
                f"{val_result['loss']:.4f}"

                f" | Val AUC "
                f"{val_result['auc']:.3f}"

                f" | Val SD "
                f"{val_result['prob_sd']:.6f}"

                f" | Best {best_epoch}"
            )



            # =================================================
            # Early stopping
            # =================================================

            if (

                epochs_without_improvement

                >=

                EARLY_STOPPING_PATIENCE
            ):


                print(
                    "Early stopping."
                )


                break



        # ====================================================
        # 18-12
        # Restore BEST epoch model
        # ====================================================

        assert best_model_state is not None


        model.load_state_dict(

            best_model_state
        )


        model.to(

            device_v6small
        )



        # ====================================================
        # 18-13
        # Deterministic Training96 evaluation
        # ====================================================

        (

            best_train_result,
            train_labels_best,
            train_probs_best,
            train_ids_best

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                train_eval_loader,

            criterion=
                criterion,

            device=
                device_v6small
        )



        # ====================================================
        # 18-14
        # Deterministic Validation24 OOF evaluation
        # ====================================================

        (

            best_val_result,
            val_labels_best,
            val_probs_best,
            val_ids_best

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device_v6small
        )



        assert np.isclose(

            best_val_result[
                "auc"
            ],

            best_val_auc,

            atol=1e-8
        )



        # ====================================================
        # 18-15
        # Validation metadata lookup
        # ====================================================

        val_lookup = (

            fold_val_df[
                [
                    "psam_IID",
                    "group_id",
                    "label"
                ]
            ]

            .copy()
        )


        val_lookup[
            "psam_IID"
        ] = (

            val_lookup[
                "psam_IID"
            ]

            .astype(str)
        )


        val_lookup = (

            val_lookup

            .set_index(
                "psam_IID"
            )
        )



        # ====================================================
        # 18-16
        # Save OOF predictions
        # ====================================================

        for (

            sample_id,
            label_value,
            prob_value

        ) in zip(

            val_ids_best,
            val_labels_best,
            val_probs_best
        ):


            sample_id = str(
                sample_id
            )


            meta = val_lookup.loc[
                sample_id
            ]


            oof_records.append(
                {

                    "repeat":
                        repeat_number,

                    "cv_fold":
                        fold_number,

                    "seed":
                        model_seed,

                    "psam_IID":
                        sample_id,

                    "group_id":
                        int(
                            meta[
                                "group_id"
                            ]
                        ),

                    "true_label":
                        int(
                            label_value
                        ),

                    "oof_probability":
                        float(
                            prob_value
                        )
                }
            )



        # ====================================================
        # 18-17
        # Save Training-reference predictions
        #
        # 之後若 V6-Small 值得繼續，
        # 可以直接做相同 standardization，
        # 不需要重跑 CNN。
        # ====================================================

        train_lookup = (

            fold_train_df[
                [
                    "psam_IID",
                    "group_id",
                    "label"
                ]
            ]

            .copy()
        )


        train_lookup[
            "psam_IID"
        ] = (

            train_lookup[
                "psam_IID"
            ]

            .astype(str)
        )


        train_lookup = (

            train_lookup

            .set_index(
                "psam_IID"
            )
        )



        for (

            sample_id,
            label_value,
            prob_value

        ) in zip(

            train_ids_best,
            train_labels_best,
            train_probs_best
        ):


            sample_id = str(
                sample_id
            )


            meta = train_lookup.loc[
                sample_id
            ]


            trainref_records.append(
                {

                    "repeat":
                        repeat_number,

                    "fold":
                        fold_number,

                    "seed":
                        model_seed,

                    "psam_IID":
                        sample_id,

                    "group_id":
                        int(
                            meta[
                                "group_id"
                            ]
                        ),

                    "true_label":
                        int(
                            label_value
                        ),

                    "train_reference_probability":
                        float(
                            prob_value
                        )
                }
            )



        # ====================================================
        # 18-18
        # Fold summary
        # ====================================================

        fold_records.append(
            {

                "repeat":
                    repeat_number,

                "fold":
                    fold_number,

                "seed":
                    model_seed,

                "best_epoch":
                    best_epoch,

                "train_auc":
                    best_train_result[
                        "auc"
                    ],

                "val_auc":
                    best_val_result[
                        "auc"
                    ],

                "auc_gap":
                    (

                        best_train_result[
                            "auc"
                        ]

                        -

                        best_val_result[
                            "auc"
                        ]
                    ),

                "train_loss":
                    best_train_result[
                        "loss"
                    ],

                "val_loss":
                    best_val_result[
                        "loss"
                    ],

                "train_prob_mean":
                    best_train_result[
                        "prob_mean"
                    ],

                "train_prob_sd":
                    best_train_result[
                        "prob_sd"
                    ],

                "val_prob_mean":
                    best_val_result[
                        "prob_mean"
                    ],

                "val_prob_sd":
                    best_val_result[
                        "prob_sd"
                    ],

                "val_prob_min":
                    best_val_result[
                        "prob_min"
                    ],

                "val_prob_max":
                    best_val_result[
                        "prob_max"
                    ],

                "parameter_count":
                    small_parameter_count
            }
        )



        # ====================================================
        # 18-19
        # Checkpoint after EVERY fold
        # ====================================================

        fold_checkpoint_df = (

            pd.DataFrame(
                fold_records
            )

            .drop_duplicates(
                subset=[
                    "repeat",
                    "fold"
                ],

                keep="last"
            )

            .sort_values(
                [
                    "repeat",
                    "fold"
                ]
            )

            .reset_index(
                drop=True
            )
        )



        oof_checkpoint_df = (

            pd.DataFrame(
                oof_records
            )

            .drop_duplicates(

                subset=[
                    "repeat",
                    "cv_fold",
                    "psam_IID"
                ],

                keep="last"
            )

            .sort_values(
                [
                    "repeat",
                    "cv_fold",
                    "psam_IID"
                ]
            )

            .reset_index(
                drop=True
            )
        )



        trainref_checkpoint_df = (

            pd.DataFrame(
                trainref_records
            )

            .drop_duplicates(

                subset=[
                    "repeat",
                    "fold",
                    "psam_IID"
                ],

                keep="last"
            )

            .sort_values(
                [
                    "repeat",
                    "fold",
                    "psam_IID"
                ]
            )

            .reset_index(
                drop=True
            )
        )



        history_checkpoint_df = (

            pd.DataFrame(
                history_records
            )

            .drop_duplicates(

                subset=[
                    "repeat",
                    "fold",
                    "epoch"
                ],

                keep="last"
            )

            .sort_values(
                [
                    "repeat",
                    "fold",
                    "epoch"
                ]
            )

            .reset_index(
                drop=True
            )
        )



        fold_checkpoint_df.to_csv(

            FOLD_CHECKPOINT_PATH,

            index=False
        )


        oof_checkpoint_df.to_csv(

            OOF_CHECKPOINT_PATH,

            index=False
        )


        trainref_checkpoint_df.to_csv(

            TRAINREF_CHECKPOINT_PATH,

            index=False
        )


        history_checkpoint_df.to_csv(

            HISTORY_CHECKPOINT_PATH,

            index=False
        )



        # ====================================================
        # 18-20
        # Print fold result
        # ====================================================

        print(
            "\n"
            +
            "-" * 95
        )


        print(

            f"Repeat {repeat_number} "
            f"Fold {fold_number} FINISHED"
        )


        print(
            "Best epoch =",
            best_epoch
        )


        print(
            "Train AUC =",
            round(
                best_train_result[
                    "auc"
                ],
                4
            )
        )


        print(
            "Validation AUC =",
            round(
                best_val_result[
                    "auc"
                ],
                4
            )
        )


        print(
            "Train-Val gap =",
            round(

                best_train_result[
                    "auc"
                ]

                -

                best_val_result[
                    "auc"
                ],

                4
            )
        )


        print(
            "Validation probability SD =",
            round(
                best_val_result[
                    "prob_sd"
                ],
                8
            )
        )


        print(
            "-" * 95
        )



        # ====================================================
        # 18-21
        # Cleanup
        # ====================================================

        completed_folds.add(
            fold_key
        )


        del model
        del best_model_state

        del train_dataset
        del train_eval_dataset
        del val_dataset

        del train_loader
        del train_eval_loader
        del val_loader

        del fold_train_df
        del fold_val_df


        gc.collect()


        if (

            hasattr(
                torch,
                "mps"
            )

            and

            torch.backends.mps.is_available()
        ):


            torch.mps.empty_cache()



# ============================================================
# STEP 19
# Final DataFrames
# ============================================================

v6small_fold_summary = (

    pd.DataFrame(
        fold_records
    )

    .drop_duplicates(

        subset=[
            "repeat",
            "fold"
        ],

        keep="last"
    )

    .sort_values(
        [

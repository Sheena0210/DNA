    ]

    >=

    LOCKED_THRESHOLD

).astype(int)



# ============================================================
# STEP 19
# Matched evaluation
#
# Each Test group:
# 1 Case + 2 Controls
# ============================================================

matched_top1_correct = []

pairwise_correct = []

matched_margins = []



for group_id, group_df in (

    test_subject_ensemble

    .groupby(
        "group_id"
    )
):


    assert len(
        group_df
    ) == 3


    case_df = (

        group_df[
            group_df[
                "true_label"
            ]
            ==
            1
        ]
    )


    control_df = (

        group_df[
            group_df[
                "true_label"
            ]
            ==
            0
        ]
    )


    assert len(
        case_df
    ) == 1


    assert len(
        control_df
    ) == 2



    case_score = float(

        case_df[
            "mean_trainref_z"
        ]
        .iloc[0]
    )


    control_scores = (

        control_df[
            "mean_trainref_z"
        ]
        .to_numpy(
            dtype=float
        )
    )



    # --------------------------------------------------------
    # Top-1
    # Case must exceed BOTH controls
    # --------------------------------------------------------

    matched_top1_correct.append(

        int(
            case_score
            >
            np.max(
                control_scores
            )
        )
    )



    # --------------------------------------------------------
    # Pairwise
    #
    # Case vs each of two controls
    # --------------------------------------------------------

    for control_score in control_scores:


        pairwise_correct.append(

            int(
                case_score
                >
                control_score
            )
        )



    # --------------------------------------------------------
    # Margin
    #
    # Case - highest control
    # --------------------------------------------------------

    matched_margins.append(

        case_score
        -
        np.max(
            control_scores
        )
    )



matched_top1 = float(

    np.mean(
        matched_top1_correct
    )
)


matched_pairwise_accuracy = float(

    np.mean(
        pairwise_correct
    )
)


mean_matched_margin = float(


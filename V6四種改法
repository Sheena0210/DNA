# ============================================================
# 8. Fold-level QC
#
# Positive scaling + location shift
# 不應改變單一 fold 內的 ranking。
#
# 因此：
#
# AUC(raw logit)
# =
# AUC(training-reference Z)
#
# 容許極小 floating-point 差異。
# ============================================================

fold_standardization_qc = []


for (
    repeat_number,
    fold_number

), fold_df in (

    oof_logit_z

    .groupby(
        [
            "repeat",
            "cv_fold"
        ]
    )
):


    raw_auc = roc_auc_score(

        fold_df[
            "true_label"
        ],

        fold_df[
            "oof_logit"
        ]
    )


    z_auc = roc_auc_score(

        fold_df[
            "true_label"
        ],

        fold_df[
            "oof_trainref_logit_z"
        ]
    )


    fold_standardization_qc.append(
        {

            "repeat":
                repeat_number,

            "fold":
                fold_number,

            "raw_logit_auc":
                raw_auc,

            "trainref_z_auc":
                z_auc,

            "auc_difference":
                z_auc
                -
                raw_auc,

            "z_mean":
                fold_df[
                    "oof_trainref_logit_z"
                ]
                .mean(),

            "z_sd":
                fold_df[
                    "oof_trainref_logit_z"
                ]
                .std(
                    ddof=1
                )
        }
    )




# STEP 10
# 建立：
#
# psam_IID → Dataset index
# ============================================================

def build_dataset_index_map(
    base_dataset
):


    id_to_index = {}


    for idx in range(
        len(base_dataset)
    ):


        item = base_dataset[
            idx
        ]


        (
            _,
            _,
            sample_id

        ) = unpack_v6_dataset_item(
            item
        )


        if sample_id in id_to_index:

            raise ValueError(
                f"Dataset 出現重複 ID：{sample_id}"
            )


        id_to_index[
            sample_id
        ] = idx


    return id_to_index



# ============================================================
# STEP 11
# MatchedGroupBatchSampler
#
# 原本：
#
# batch size = 2 subjects
#
# 現在：
#
# batch = 1 whole matched set
#
#       Case
#       Control
#       Control
#
# 共 3 subjects。
# ============================================================

class MatchedGroupBatchSampler(Sampler):


    def __init__(
        self,
        base_dataset,
        metadata_df,
        shuffle,
        seed
    ):


        self.base_dataset = (
            base_dataset
        )


        self.metadata_df = (

            metadata_df

            .copy()

            .reset_index(
                drop=True
            )
        )


        self.shuffle = bool(
            shuffle
        )


        self.seed = int(
            seed
        )


        self.epoch = 0



        # ----------------------------------------------------
        # Dataset index lookup
        # ----------------------------------------------------

        self.id_to_index = (

            build_dataset_index_map(
                base_dataset
            )
        )



        # ----------------------------------------------------
        # 儲存每一組的三個 indices
        # ----------------------------------------------------

        self.group_batches = []


        grouped = (

            self.metadata_df

            .groupby(
                "group_id",
                sort=True
            )
        )


        for group_id, group_df in grouped:


            if len(group_df) != 3:

                raise ValueError(
                    f"Group {group_id} "
                    f"has {len(group_df)} subjects."
                )


            if int(
                group_df[
                    "label"
                ]
                .sum()
            ) != 1:

                raise ValueError(
                    f"Group {group_id} "
                    "does not contain exactly 1 Case."
                )


            group_subject_ids = (

                group_df[
                    "psam_IID"
                ]

                .astype(str)

                .tolist()
            )


            missing_ids = [

                sample_id

                for sample_id
                in group_subject_ids

                if sample_id
                not in self.id_to_index
            ]


            if len(missing_ids) > 0:

                raise KeyError(
                    f"Group {group_id} "
                    f"找不到 subjects：{missing_ids}"
                )


            group_indices = [

                self.id_to_index[
                    sample_id
                ]

                for sample_id
                in group_subject_ids
            ]


            self.group_batches.append(

                (
                    group_id,
                    group_indices
                )
            )



    # --------------------------------------------------------
    # 每一個 epoch 改變 matched groups 順序
    # --------------------------------------------------------

    def set_epoch(
        self,
        epoch
    ):

        self.epoch = int(
            epoch
        )



    def __iter__(
        self
    ):


        order = list(

            range(
                len(
                    self.group_batches
                )
            )
        )


        if self.shuffle:


            rng = random.Random(

                self.seed
                +
                self.epoch
            )


            rng.shuffle(
                order
            )


        for position in order:


            (
                _,
                group_indices

            ) = self.group_batches[
                position
            ]


            # ------------------------------------------------
            # DataLoader 一次收到三個 indices
            #
            # 所以同一 matched set 永遠不會拆開。
            # ------------------------------------------------

            yield group_indices



    def __len__(
        self
    ):

        return len(
            self.group_batches
        )



# ============================================================
# STEP 12
# Matched-set conditional loss
#
# 每組：
#
# s_case
# s_control1
# s_control2
#
#
# L =
#
#   -s_case
#   +
#   logsumexp(
#       s_case,
#       s_control1,
#       s_control2
#   )
#
#
# 直接使用 raw logits。
#
# 不經 sigmoid。
# 不使用 pos_weight。
# ============================================================

def matched_set_loss(
    logits,
    labels
):


    logits = (

        logits
        .view(-1)
    )


    labels = (

        labels
        .view(-1)
        .long()
    )



    # --------------------------------------------------------
    # 每組一定三人
    # --------------------------------------------------------

    if logits.numel() != 3:

        raise ValueError(
            "Matched loss 每 batch 必須是 3 subjects，"
            f"目前為 {logits.numel()}。"
        )



    # --------------------------------------------------------
    # 每組一定一個 Case
    # --------------------------------------------------------

    if int(
        labels.sum().item()
    ) != 1:

        raise ValueError(
            "Matched loss 每組必須剛好 1 Case。"
        )



    # --------------------------------------------------------
    # 找 Case index
    # --------------------------------------------------------

    case_index = (

        torch.where(
            labels == 1
        )[0]
        .item()
    )



    # --------------------------------------------------------
    # Case raw logit
    # --------------------------------------------------------

    case_logit = (

        logits[
            case_index
        ]
    )



    # --------------------------------------------------------
    # Matched-set loss
    # --------------------------------------------------------

    loss = (

        -case_logit

        +

        torch.logsumexp(
            logits,
            dim=0
        )
    )


    return loss



# ============================================================
# STEP 13
# Matched-set ranking diagnostics
#
# margin =
#
# Case logit
# -
# highest Control logit
#
#
# margin > 0：
# Case 比兩個 controls 都高。
#
#
# top1：
#
# Case 是否 STRICTLY 大於兩個 controls。
#
# 若 tie → 不算成功。
# ============================================================

def matched_group_diagnostics(
    logits,
    labels
):


    logits = (

        logits

        .detach()

        .view(-1)
    )


    labels = (

        labels

        .detach()

        .view(-1)

        .long()
    )


    case_index = (

        torch.where(
            labels == 1
        )[0]
        .item()
    )


    control_indices = (

        torch.where(
            labels == 0
        )[0]
    )


    case_logit = (

        logits[
            case_index
        ]
    )


    highest_control_logit = (

        logits[
            control_indices
        ]
        .max()
    )


    margin = float(

        (
            case_logit
            -
            highest_control_logit
        )

        .cpu()
        .item()
    )



    # --------------------------------------------------------
    # Strict top-1
    #
    # Case 必須真正比兩個 controls 都高。
    # --------------------------------------------------------

    top1 = int(

        case_logit.item()
        >
        highest_control_logit.item()
    )


    return (
        top1,
        margin
    )



# ============================================================
# STEP 14
# Subject-level metrics
#
# 這裡就是剛剛出錯地方的正式修正版。
#
#
# 理論：
#
# probability = sigmoid(logit)
#
# sigmoid 是 monotonic transformation，
# 所以理論上 ranking 不變。
#
#
# 但實際：
#
# float32 + sigmoid
# 可能把非常接近的 logits 壓成 probability ties。
#
#
# 因此：
#
# 不再 assert：
#
# AUC(probability) == AUC(logit)
#
#
# 而是同時記錄兩種 AUC。
#
#
# Primary AUC：
#
# RAW LOGIT AUC
# ============================================================

def summarize_subject_scores(
    labels,
    probabilities,
    logits
):


    labels = np.asarray(
        labels,
        dtype=int
    )


    probabilities = np.asarray(
        probabilities,
        dtype=float
    )


    logits = np.asarray(
        logits,
        dtype=float
    )



    # --------------------------------------------------------
    # Probability-based AUC
    # --------------------------------------------------------

    auc_probability = roc_auc_score(

        labels,
        probabilities
    )



    # --------------------------------------------------------
    # Raw-logit AUC
    #
    # matched loss 直接在 logits 上訓練，
    # 因此把這個當主要 ranking metric。
    # --------------------------------------------------------

    auc_logit = roc_auc_score(

        labels,
        logits
    )



    # --------------------------------------------------------
    # Difference
    #
    # 若 probability 出現 precision ties，
    # 這裡可能不完全等於 0。
    # --------------------------------------------------------

    auc_difference = float(

        auc_logit
        -
        auc_probability
    )



    # --------------------------------------------------------
    # Distinct score 數量
    #
    # 可診斷 sigmoid 是否壓成 ties。
    # --------------------------------------------------------

    n_unique_logits = int(

        np.unique(
            logits
        )
        .size
    )


    n_unique_probabilities = int(

        np.unique(
            probabilities
        )
        .size
    )



    return {

        # ----------------------------------------------------
        # Primary AUC
        # ----------------------------------------------------

        "auc":
            float(
                auc_logit
            ),


        # ----------------------------------------------------
        # Explicit AUC outputs
        # ----------------------------------------------------

        "auc_logit":
            float(
                auc_logit
            ),

        "auc_probability":
            float(
                auc_probability
            ),

        "auc_logit_minus_probability":
            auc_difference,


        # ----------------------------------------------------
        # Probability summary
        # ----------------------------------------------------

        "prob_mean":
            float(
                probabilities.mean()
            ),

        "prob_sd":
            float(
                probabilities.std(
                    ddof=1
                )
            ),

        "prob_min":
            float(
                probabilities.min()
            ),

        "prob_max":
            float(
                probabilities.max()
            ),

        "n_unique_probabilities":
            n_unique_probabilities,


        # ----------------------------------------------------
        # Logit summary
        # ----------------------------------------------------

        "logit_mean":
            float(
                logits.mean()
            ),

        "logit_sd":
            float(
                logits.std(
                    ddof=1
                )
            ),

        "logit_min":
            float(
                logits.min()
            ),

        "logit_max":
            float(
                logits.max()
            ),

        "n_unique_logits":
            n_unique_logits
    }



# ============================================================
# STEP 15
# Train one epoch
#
# 一個 batch = 一個完整 matched group。
# ============================================================

def train_one_epoch_matched(
    model,
    data_loader,
    batch_sampler,
    optimizer,
    device,
    epoch
):


    model.train()



    # --------------------------------------------------------
    # 每 epoch shuffle matched-set order
    # --------------------------------------------------------

    batch_sampler.set_epoch(
        epoch
    )



    total_loss = 0.0

    n_groups = 0


    all_labels = []

    all_probabilities = []

    all_logits = []


    matched_top1_results = []

    matched_margins = []



    for (
        images,
        labels,
        sample_ids

    ) in data_loader:


        images = images.to(
            device
        )


        labels = (

            labels

            .to(device)

            .float()

            .view(-1)
        )



        # ----------------------------------------------------
        # 一 batch = 3 subjects
        # ----------------------------------------------------

        assert images.shape[0] == 3

        assert labels.shape[0] == 3



        # ----------------------------------------------------
        # 清除 gradient
        # ----------------------------------------------------

        optimizer.zero_grad()



        # ----------------------------------------------------
        # Forward
        #
        # output = raw logits
        # ----------------------------------------------------

        logits = (

            model(
                images
            )

            .view(-1)
        )


        assert logits.shape[0] == 3



        # ----------------------------------------------------
        # Matched loss
        # ----------------------------------------------------

        loss = matched_set_loss(

            logits=
                logits,

            labels=
                labels
        )



        # ----------------------------------------------------
        # Backpropagation
        # ----------------------------------------------------

        loss.backward()



        # ----------------------------------------------------
        # Parameter update
        # ----------------------------------------------------

        optimizer.step()



        # ----------------------------------------------------
        # Loss
        # ----------------------------------------------------

        total_loss += float(

            loss

            .detach()

            .cpu()

            .item()
        )


        n_groups += 1



        # ----------------------------------------------------
        # Probability 只拿來：
        #
        # AUC
        # diagnostics
        #
        # 不參與 loss。
        # ----------------------------------------------------

        probabilities = (

            torch.sigmoid(
                logits
            )

            .detach()

            .cpu()

            .numpy()
        )


        logits_np = (

            logits

            .detach()

            .cpu()

            .numpy()
        )


        labels_np = (

            labels

            .detach()

            .cpu()

            .numpy()

            .astype(int)
        )



        all_probabilities.extend(

            probabilities.tolist()
        )


        all_logits.extend(

            logits_np.tolist()
        )


        all_labels.extend(

            labels_np.tolist()
        )



        (
            top1,
            margin

        ) = matched_group_diagnostics(

            logits=
                logits,

            labels=
                labels
        )


        matched_top1_results.append(
            top1
        )


        matched_margins.append(
            margin
        )



    # ========================================================
    # Epoch summary
    # ========================================================

    result = summarize_subject_scores(

        labels=
            all_labels,

        probabilities=
            all_probabilities,

        logits=
            all_logits
    )


    result[
        "loss"
    ] = (

        total_loss
        /
        n_groups
    )


    result[
        "matched_top1_accuracy"
    ] = float(

        np.mean(
            matched_top1_results
        )
    )


    result[
        "matched_margin_mean"
    ] = float(

        np.mean(
            matched_margins
        )
    )


    result[
        "matched_margin_median"
    ] = float(

        np.median(
            matched_margins
        )
    )


    return result



# ============================================================
# STEP 16
# Evaluation
#
# 回傳：
#
# result
# labels
# probabilities
# raw logits
# psam_IIDs
# ============================================================

def evaluate_matched(
    model,
    data_loader,
    device
):


    model.eval()


    total_loss = 0.0

    n_groups = 0


    all_labels = []

    all_probabilities = []

    all_logits = []

    all_ids = []


    matched_top1_results = []

    matched_margins = []



    with torch.no_grad():


        for (
            images,
            labels,
            sample_ids

        ) in data_loader:


            images = images.to(
                device
            )


            labels = (

                labels

                .to(device)

                .float()

                .view(-1)
            )


            assert images.shape[0] == 3
            assert labels.shape[0] == 3



            # ------------------------------------------------
            # Raw logits
            # ------------------------------------------------

            logits = (

                model(
                    images
                )

                .view(-1)
            )



            # ------------------------------------------------
            # Matched loss
            # ------------------------------------------------

            loss = matched_set_loss(

                logits=
                    logits,

                labels=
                    labels
            )


            total_loss += float(

                loss

                .detach()

                .cpu()

                .item()
            )


            n_groups += 1



            # ------------------------------------------------
            # Probability
            # ------------------------------------------------

            probabilities = (

                torch.sigmoid(
                    logits
                )

                .detach()

                .cpu()

                .numpy()
            )


            logits_np = (

                logits

                .detach()

                .cpu()

                .numpy()
            )


            labels_np = (

                labels

                .detach()

                .cpu()

                .numpy()

                .astype(int)
            )



            all_probabilities.extend(

                probabilities.tolist()
            )


            all_logits.extend(

                logits_np.tolist()
            )


            all_labels.extend(

                labels_np.tolist()
            )


            all_ids.extend(

                [
                    str(x)
                    for x
                    in sample_ids
                ]
            )



            (
                top1,
                margin

            ) = matched_group_diagnostics(

                logits=
                    logits,

                labels=
                    labels
            )


            matched_top1_results.append(
                top1
            )


            matched_margins.append(
                margin
            )



    # ========================================================
    # Metrics
    # ========================================================

    result = summarize_subject_scores(

        labels=
            all_labels,

        probabilities=
            all_probabilities,

        logits=
            all_logits
    )


    result[
        "loss"
    ] = (

        total_loss
        /
        n_groups
    )


    result[
        "matched_top1_accuracy"
    ] = float(

        np.mean(
            matched_top1_results
        )
    )


    result[
        "matched_margin_mean"
    ] = float(

        np.mean(
            matched_margins
        )
    )


    result[
        "matched_margin_median"
    ] = float(

        np.median(
            matched_margins
        )
    )


    return (

        result,

        np.asarray(
            all_labels,
            dtype=int
        ),

        np.asarray(
            all_probabilities,
            dtype=float
        ),

        np.asarray(
            all_logits,
            dtype=float
        ),

        all_ids
    )




            pos_weight_print = float(

                pos_weight_value

                .detach()

                .cpu()

                .item()
            )


        else:


            pos_weight_print = float(
                pos_weight_value
            )


        print(
            "Loss = Weighted BCEWithLogitsLoss"
        )


        print(
            "pos_weight =",
            pos_weight_print
        )


        print(
            "Optimizer =",
            optimizer.__class__.__name__
        )


        print(
            "LR =",
            LEARNING_RATE
        )


        print(
            "Weight decay =",
            WEIGHT_DECAY
        )



        # ====================================================
        # Scheduler
        # ====================================================

        scheduler = (

            torch.optim.lr_scheduler
            .ReduceLROnPlateau(

                optimizer,

                mode="max",

                factor=
                    LR_FACTOR,

                patience=
                    LR_PATIENCE,

                min_lr=
                    MIN_LEARNING_RATE
            )
        )



        # ====================================================
        # Best epoch tracking
        # ====================================================

        best_val_auc = -np.inf

        best_val_loss = np.inf

        best_epoch = 0

        best_model_state = None

        epochs_without_improvement = 0



        # ====================================================
        # Training epochs
        # ====================================================

        for epoch in range(
            1,
            MAX_EPOCHS + 1
        ):


            # ------------------------------------------------
            # Train
            # ------------------------------------------------

            train_result = train_one_epoch(

                model=
                    model,

                data_loader=
                    train_loader,

                criterion=
                    criterion,

                optimizer=
                    optimizer,

                device=
                    device_localstem
            )



            # ------------------------------------------------
            # Validation
            # ------------------------------------------------

            (

                val_result,
                _,
                _,
                _

            ) = evaluate_one_epoch(

                model=
                    model,

                data_loader=
                    val_loader,

                criterion=
                    criterion,

                device=
                    device_localstem
            )



            current_lr = (

                optimizer

                .param_groups[0][
                    "lr"
                ]
            )



            # =================================================
            # History
            # =================================================

            history_records.append(
                {

                    "repeat":
                        repeat_number,

                    "fold":
                        fold_number,

                    "seed":
                        model_seed,

                    "epoch":
                        epoch,

                    "learning_rate":
                        current_lr,

                    "train_loss":
                        train_result[
                            "loss"
                        ],

                    "train_auc":
                        train_result[
                            "auc"
                        ],

                    "train_prob_mean":
                        train_result[
                            "prob_mean"
                        ],

                    "train_prob_sd":
                        train_result[
                            "prob_sd"
                        ],

                    "val_loss":
                        val_result[
                            "loss"
                        ],

                    "val_auc":
                        val_result[
                            "auc"
                        ],

                    "val_prob_mean":
                        val_result[
                            "prob_mean"
                        ],

                    "val_prob_sd":
                        val_result[
                            "prob_sd"
                        ]
                }
            )



            # =================================================
            # Best epoch selection
            #
            # SAME AS Exp1:
            #
            # 1. higher Validation AUC
            #
            # 2. if AUC tie:
            #    lower Validation loss
            # =================================================

            auc_improved = (

                val_result[
                    "auc"
                ]

                >
                best_val_auc
                +
                1e-8
            )



            auc_tied_loss_improved = (

                abs(

                    val_result[
                        "auc"
                    ]

                    -
                    best_val_auc
                )

                <=
                1e-8

                and

                val_result[
                    "loss"
                ]

                <
                best_val_loss
            )



            is_best = (

                auc_improved

                or

                auc_tied_loss_improved
            )



            if is_best:


                best_val_auc = float(

                    val_result[
                        "auc"
                    ]
                )


                best_val_loss = float(

                    val_result[
                        "loss"
                    ]
                )


                best_epoch = int(
                    epoch
                )


                best_model_state = {

                    key:

                        value

                        .detach()

                        .cpu()

                        .clone()

                    for key, value

                    in model
                    .state_dict()
                    .items()
                }


                epochs_without_improvement = 0



            else:


                epochs_without_improvement += 1



            # =================================================
            # Scheduler
            # =================================================

            scheduler.step(

                val_result[
                    "auc"
                ]
            )



            # =================================================
            # Print epoch
            # =================================================

            print(

                f"Epoch {epoch:02d}"

                f" | LR {current_lr:.2e}"

                f" | Train loss "
                f"{train_result['loss']:.4f}"

                f" | Train AUC "
                f"{train_result['auc']:.3f}"

                f" | Val loss "
                f"{val_result['loss']:.4f}"

                f" | Val AUC "
                f"{val_result['auc']:.3f}"

                f" | Val SD "
                f"{val_result['prob_sd']:.6f}"

                f" | Best {best_epoch}"
            )



            # =================================================
            # Early stopping
            # =================================================

            if (

                epochs_without_improvement

                >=

                EARLY_STOPPING_PATIENCE
            ):


                print(
                    "Early stopping."
                )


                break



        # ====================================================
        # Restore BEST model
        # ====================================================

        assert best_model_state is not None


        model.load_state_dict(

            best_model_state
        )


        model.to(
            device_localstem

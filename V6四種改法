# ============================================================
# 2. 建立計算 classification metrics 的 function
# ============================================================

def calculate_threshold_metrics(
    y_true,
    probabilities,
    threshold
):


    # --------------------------------------------------------
    # probability >= threshold
    # 判定為 Case = 1
    #
    # probability < threshold
    # 判定為 Control = 0
    # --------------------------------------------------------

    y_pred = (

        probabilities
        >=
        threshold

    ).astype(int)



    # --------------------------------------------------------
    # 建立 confusion matrix
    #
    # labels=[0,1]
    #
    # 所以順序固定為：
    #
    # TN FP
    # FN TP
    # --------------------------------------------------------

    tn, fp, fn, tp = (

        confusion_matrix(

            y_true,

            y_pred,

            labels=[
                0,
                1
            ]

        )
        .ravel()
    )



    # --------------------------------------------------------
    # Accuracy
    # --------------------------------------------------------

    accuracy = (

        (tp + tn)
        /
        (tp + tn + fp + fn)

    )



    # --------------------------------------------------------
    # Sensitivity
    #
    # TP / (TP + FN)
    #
    # 真正 Case 中有多少被抓到
    # --------------------------------------------------------

    sensitivity = (

        tp
        /
        (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan

    )



    # --------------------------------------------------------
    # Specificity
    #
    # TN / (TN + FP)
    #
    # 真正 Control 中有多少被正確判斷
    # --------------------------------------------------------

    specificity = (

        tn
        /
        (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan

    )



    # --------------------------------------------------------
    # PPV
    #
    # TP / (TP + FP)
    #
    # 預測為 Case 的人中，
    # 有多少真的為 Case
    # --------------------------------------------------------

    ppv = (

        tp
        /
        (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan

    )



    # --------------------------------------------------------
    # NPV
    #
    # TN / (TN + FN)
    #
    # 預測為 Control 的人中，
    # 有多少真的為 Control
    # --------------------------------------------------------

    npv = (

        tn
        /
        (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan

    )



    # --------------------------------------------------------
    # Balanced Accuracy
    #
    # (Sensitivity + Specificity) / 2
    #
    # 因為你的 case/control = 1:2，
    # 所以 Balanced Accuracy
    # 比單純 Accuracy 更適合比較 threshold。
    # --------------------------------------------------------

    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2



    # --------------------------------------------------------
    # Youden Index
    #
    # J =
    # Sensitivity + Specificity - 1
    # --------------------------------------------------------

    youden_j = (

        sensitivity
        +
        specificity
        -
        1
    )



    # --------------------------------------------------------
    # Sensitivity / Specificity convergence gap
    #
    # 越小代表兩者越接近
    # --------------------------------------------------------

    sens_spec_gap = abs(

        sensitivity
        -
        specificity

    )



    return {

        "threshold":
            threshold,

        "TN":
            int(tn),

        "FP":
            int(fp),

        "FN":
            int(fn),

        "TP":
            int(tp),

        "accuracy":
            accuracy,

        "sensitivity":
            sensitivity,

        "specificity":
            specificity,

        "PPV":
            ppv,

        "NPV":
            npv,

        "balanced_accuracy":
            balanced_accuracy,

        "youden_j":
            youden_j,

        "sens_spec_gap":
            sens_spec_gap
    }



# ============================================================
# 3. 建立所有可能的 Threshold Candidates
# ============================================================

def create_threshold_candidates(
    probabilities
):


    # --------------------------------------------------------
    # 將 probability 排序
    # 並去除重複值
    # --------------------------------------------------------

    unique_probs = np.sort(

        np.unique(
            probabilities
        )
    )



    # --------------------------------------------------------
    # 相鄰兩個 probability 取中點
    #
    # 例如：
    #
    # 0.3911
    # 0.3913
    #
    # threshold =
    #
    # (0.3911 + 0.3913) / 2
    #
    # = 0.3912
    #
    #
    # 這樣 threshold 不會剛好等於
    # 某一個人的 probability。
    # --------------------------------------------------------

    midpoints = (

        unique_probs[:-1]
        +
        unique_probs[1:]

    ) / 2



    # --------------------------------------------------------
    # 再加入最低值以下、
    # 最高值以上的 threshold
    #
    # 用來涵蓋：
    #
    # 全部預測 Case
    #
    # 以及
    #
    # 全部預測 Control
    # --------------------------------------------------------

    epsilon = max(

        1e-8,

        (
            unique_probs.max()
            -
            unique_probs.min()
        )
        *
        0.001
    )


    lower_threshold = (

        unique_probs.min()
        -
        epsilon
    )


    upper_threshold = (

        unique_probs.max()
        +
        epsilon
    )



    threshold_candidates = np.concatenate(
        [

            [
                lower_threshold
            ],

            midpoints,

            [
                upper_threshold
            ]
        ]
    )



    return threshold_candidates



# ============================================================
# 4. 建立單一 Fold Threshold Scan Function
# ============================================================

def scan_thresholds_one_fold(
    fold_df,
    fold_number
):


    y_true = (

        fold_df[
            "true_label"
        ]
        .to_numpy()
        .astype(int)
    )


    probabilities = (

        fold_df[
            "oof_probability"
        ]
        .to_numpy()
        .astype(float)
    )



    # --------------------------------------------------------
    # 產生所有有意義的 threshold
    # --------------------------------------------------------

    thresholds = (

        create_threshold_candidates(
            probabilities
        )
    )



    threshold_results = []



    # --------------------------------------------------------
    # 每一個 threshold 都計算 metrics
    # --------------------------------------------------------

    for threshold in thresholds:


        result = (

            calculate_threshold_metrics(

                y_true=
                    y_true,

                probabilities=
                    probabilities,

                threshold=
                    threshold
            )
        )


        result[
            "fold"
        ] = fold_number


        threshold_results.append(
            result
        )



    threshold_df = pd.DataFrame(

        threshold_results

    )



    # --------------------------------------------------------
    # 調整欄位順序
    # --------------------------------------------------------

    threshold_df = threshold_df[
        [

            "fold",

            "threshold",

            "TN",

            "FP",

            "FN",

            "TP",

            "accuracy",

            "sensitivity",

            "specificity",

            "PPV",

            "NPV",

            "balanced_accuracy",

            "youden_j",

            "sens_spec_gap"
        ]
    ]



    return threshold_df




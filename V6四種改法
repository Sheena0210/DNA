    )



    # ========================================================
    # 6-7. LR Scheduler
    # ========================================================

    scheduler = (

        torch.optim.lr_scheduler
        .ReduceLROnPlateau(

            optimizer,

            mode="max",

            factor=
                LR_FACTOR,

            patience=
                LR_PATIENCE,

            min_lr=
                MIN_LEARNING_RATE
        )
    )



    # ========================================================
    # 6-8. Best-model tracking
    # ========================================================

    best_val_auc = -np.inf

    best_val_loss = np.inf

    best_epoch = 0

    best_model_state = None

    epochs_without_improvement = 0



    # ========================================================
    # 6-9. Training
    # ========================================================

    for epoch in range(

        1,

        MAX_EPOCHS + 1
    ):


        # ----------------------------------------------------
        # Training pass
        # ----------------------------------------------------

        train_result = train_one_epoch(

            model=

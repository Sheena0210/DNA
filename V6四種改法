# ============================================================
# EXPERIMENT 1
# STEP 7
#
# Training-reference Standardization
#
# 目的：
#
# 之前的 within-fold Z-score：
#
#     z_val =
#     (validation probability - validation mean)
#     ------------------------------------------
#                 validation SD
#
# 雖然適合 diagnostic，
# 但使用了 validation fold 自己的分布。
#
#
# 這一步改成：
#
#     z_trainref =
#     (validation probability - training mean)
#     -----------------------------------------
#                  training SD
#
#
# Training mean / SD 完全來自該 model 的 Training 96 人。
#
#
# 主要問題：
#
# 1. 只使用 training reference 後，
#    Case > Control 的 ranking signal 還在嗎？
#
# 2. 每個 subject 5 次 OOF train-reference Z-score
#    平均之後，AUC 是多少？
#
# 3. 和：
#
#       raw probability
#       validation-reference Z-score
#       percentile rank
#
#    相比如何？
#
#
# 注意：
#
# 這一步仍然不使用 Outer Test 30 人。
# ============================================================



# ============================================================
# 0. 載入套件
# ============================================================

from pathlib import Path


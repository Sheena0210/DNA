        .max()
    )


    candidates = (

        candidates[

            np.isclose(

                candidates[
                    "youden_j"
                ],

                max_youden
            )
        ]

        .copy()
    )



    # --------------------------------------------------------
    # 如果最後還有多個 threshold，
    # 取其中間的 threshold。
    #
    # 避免任意取最低或最高 cutoff。
    # --------------------------------------------------------

    candidates = (

        candidates

        .sort_values(
            "threshold"
        )

        .reset_index(
            drop=True
        )
    )


    selected_index = (

        len(
            candidates
        )
        //
        2
    )


    selected_row = (

        candidates
        .iloc[
            selected_index
        ]
        .copy()
    )


    selected_row[
        "selection_method"
    ] = "Min Sens-Spec Gap"


    primary_optimal_rows.append(


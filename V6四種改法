        test_result,
        test_labels,
        test_probs,
        test_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            test_loader,

        criterion=
            criterion,

        device=
            device_localstem
    )



    # ========================================================
    # Train-reference mean / SD
    # ========================================================

    train_probs = np.asarray(
        train_probs,
        dtype=float
    )


    test_probs = np.asarray(
        test_probs,
        dtype=float
    )


    train_reference_mean = float(

        np.mean(
            train_probs
        )
    )


    train_reference_sd = float(

        np.std(
            train_probs,

            ddof=1
        )
    )


    assert train_reference_sd > 0



    # ========================================================
    # Test Train-reference Z
    # ========================================================

    test_z = (

        test_probs
        -
        train_reference_mean

    ) / train_reference_sd



    print(
        "\nTrain-reference probability mean =",
        train_reference_mean
    )


    print(
        "Train-reference probability SD =",
        train_reference_sd
    )


    print(
        "Deterministic Train AUC =",
        round(
            train_eval_result[
                "auc"
            ],
            4
        )
    )


    print(
        "Model Test raw probability AUC =",
        round(
            test_result[
                "auc"
            ],
            4
        )
    )



    # ========================================================
    # Metadata lookup
    # ========================================================

    test_lookup = (

        exp1_test_df[
            [
                "psam_IID",
                "group_id",
                "label"
            ]
        ]

        .copy()
    )


    test_lookup[
        "psam_IID"
    ] = (

        test_lookup[
            "psam_IID"
        ]
        .astype(str)
    )


    test_lookup = (

        test_lookup

        .set_index(
            "psam_IID"
        )
    )



    # ========================================================
    # Save subject predictions
    # ========================================================

    for (

        sample_id,
        label_value,
        raw_probability,
        z_value

    ) in zip(

        test_ids,
        test_labels,
        test_probs,
        test_z
    ):


        sample_id = str(
            sample_id
        )


        meta = test_lookup.loc[
            sample_id
        ]


        final_test_prediction_records.append(
            {

                "model_number":
                    model_number,

                "seed":
                    model_seed,

                "psam_IID":
                    sample_id,

                "group_id":
                    int(
                        meta[
                            "group_id"
                        ]
                    ),

                "true_label":
                    int(
                        label_value
                    ),

                "raw_probability":
                    float(
                        raw_probability
                    ),

                "train_reference_mean":
                    train_reference_mean,

                "train_reference_sd":
                    train_reference_sd,

                "trainref_z":
                    float(
                        z_value
                    )
            }
        )



    # ========================================================
    # Save model summary
    # ========================================================

    final_model_summary.append(
        {

            "model_number":
                model_number,

            "seed":
                model_seed,

            "epochs":
                FINAL_EPOCHS,

            "train_auc":
                float(
                    train_eval_result[
                        "auc"
                    ]
                ),

            "test_raw_auc":
                float(
                    test_result[
                        "auc"
                    ]
                ),

            "train_reference_mean":
                train_reference_mean,

            "train_reference_sd":
                train_reference_sd
        }
    )



    # ========================================================
    # Save model weights
    # ========================================================

    torch.save(

        {

            "model_state_dict":
                model
                .state_dict(),

            "seed":
                model_seed,

            "epochs":
                FINAL_EPOCHS,

            "train_reference_mean":
                train_reference_mean,

            "train_reference_sd":
                train_reference_sd,

            "locked_threshold":
                LOCKED_THRESHOLD
        },

        EXP5_FINAL_DIR
        /
        f"Exp5_FinalModel_{model_number}_seed{model_seed}.pt"
    )



    # ========================================================
    # Cleanup
    # ========================================================

    del model

    del train_dataset
    del train_eval_dataset
    del test_dataset

    del train_loader
    del train_eval_loader
    del test_loader


    gc.collect()


    if (

        hasattr(
            torch,
            "mps"
        )

        and

        torch.backends.mps.is_available()
    ):


        torch.mps.empty_cache()




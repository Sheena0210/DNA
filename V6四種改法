# ============================================================
# 5. 固定 Random Seed 的 function
# ============================================================

def set_exp1_seed(seed):


    random.seed(
        seed
    )


    np.random.seed(
        seed
    )


    torch.manual_seed(
        seed
    )


    if torch.cuda.is_available():

        torch.cuda.manual_seed_all(
            seed
        )


# ------------------------------------------------------------
# CNN 中有許多隨機過程：
#
# - model weight initialization
# - batch shuffle
# - dropout
#
# 固定 seed 可以增加 reproducibility。
# ------------------------------------------------------------





# ============================================================
# 6. 建立 Experiment 1 的 V6 Model
# ============================================================

def build_exp1_v6_model(
    seed,
    device,
    dropout_rate=0.5
):


    # --------------------------------------------------------
    # 6-1.
    # 先建立原本 V3 的 GroupNorm ResNet18
    # --------------------------------------------------------

    model = build_resnet18_v3_model(

        seed=seed,

        device=device,

        dropout_rate=dropout_rate
    )


    # --------------------------------------------------------
    # 6-2.
    # V6 的主要修改：
    #
    # 移除 ResNet18 最前面的 MaxPool
    # --------------------------------------------------------

    model.maxpool = nn.Identity()


    # --------------------------------------------------------
    # 6-3.
    # 把模型移到 MPS / CUDA / CPU
    # --------------------------------------------------------

    model = model.to(
        device
    )


    return model


# ------------------------------------------------------------
# V6：
#
# Input
#   ↓
# Conv 7×7
#   ↓
# NO Initial MaxPool
#   ↓
# Residual Blocks
#   ↓
# Global Average Pooling
#   ↓
# Dropout
#   ↓
# Linear
#
# Initial MaxPool：
#
# nn.Identity()
#
# 表示資料直接通過，不做 pooling。
# ------------------------------------------------------------





# ============================================================
# 7. 建立「單一 Fold」Training Function
# ============================================================

def train_exp1_v6_one_fold(
    exp1_train_df,
    fold_number,
    device
):


    # ========================================================
    # 7-1.
    # 每一 fold 使用不同但固定的 seed
    # ========================================================

    fold_seed = (

        EXP1_TRAINING_SEED
        +
        fold_number
    )


    set_exp1_seed(
        fold_seed
    )


    print(
        "\n"
        +
        "=" * 75
    )


    print(
        f"EXPERIMENT 1 | V6 | INTERNAL FOLD {fold_number}"
    )


    print(
        f"Fold seed = {fold_seed}"
    )


    print(
        "=" * 75
    )


    # --------------------------------------------------------
    # Fold 1：
    # seed = 20260925
    #
    # Fold 2：
    # seed = 20260926
    #
    # ...
    #
    # 每次重新執行仍會得到相同 seed。
    # --------------------------------------------------------





    # ========================================================
    # 7-2.
    # 建立這一 fold 的 Internal Train / Validation
    # ========================================================

    internal_train_df = (

        exp1_train_df[

            exp1_train_df["cv_fold"]
            !=
            fold_number
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    internal_val_df = (

        exp1_train_df[

            exp1_train_df["cv_fold"]
            ==
            fold_number
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    # --------------------------------------------------------
    # 例如 Fold 1：
    #
    # CV Fold 1：
    # 24 人 → Validation
    #
    # Fold 2+3+4+5：
    # 96 人 → Training
    #
    #
    # 下一輪 Fold 2：
    #
    # Fold 2：
    # 24 人 → Validation
    #
    # 其他：
    # 96 人 → Training
    # --------------------------------------------------------





    # ========================================================
    # 7-3.
    # 樣本數 QC
    # ========================================================

    assert (
        len(
            internal_train_df
        )
        ==
        96
    )


    assert (
        len(
            internal_val_df
        )
        ==
        24
    )


    # --------------------------------------------------------
    # Training：
    #
    # 32 case
    # 64 control
    # --------------------------------------------------------

    assert (

        (
            internal_train_df["label"]
            ==
            1
        )
        .sum()

        ==
        32
    )


    assert (

        (
            internal_train_df["label"]
            ==
            0
        )
        .sum()

        ==
        64
    )


    # --------------------------------------------------------
    # Validation：
    #
    # 8 case
    # 16 control
    # --------------------------------------------------------

    assert (

        (
            internal_val_df["label"]
            ==
            1
        )
        .sum()

        ==
        8
    )


    assert (

        (
            internal_val_df["label"]
            ==
            0
        )
        .sum()

        ==
        16
    )


    print(
        "Internal Train =",
        len(
            internal_train_df
        )
    )


    print(
        "Internal Validation =",
        len(
            internal_val_df
        )
    )


    print(
        "Train cases =",
        (
            internal_train_df["label"]
            ==
            1
        ).sum()
    )


    print(
        "Train controls =",
        (
            internal_train_df["label"]
            ==
            0
        ).sum()
    )


    print(
        "Validation cases =",
        (
            internal_val_df["label"]
            ==
            1
        ).sum()
    )


    print(
        "Validation controls =",
        (
            internal_val_df["label"]
            ==
            0
        ).sum()
    )





    # ========================================================
    # 7-4.
    # Matched-group leakage QC
    # ========================================================

    internal_train_groups = set(

        internal_train_df[
            "group_id"
        ]
        .unique()
    )


    internal_val_groups = set(

        internal_val_df[
            "group_id"
        ]
        .unique()
    )


    assert (
        internal_train_groups
        .isdisjoint(
            internal_val_groups
        )
    )


    print(
        "Matched-group leakage QC passed."
    )


    # --------------------------------------------------------
    # 確保：
    #
    # 同一 matched group 的人
    #
    # 不會有人在 Training，
    # 另一個人在 Validation。
    # --------------------------------------------------------





    # ========================================================
    # 7-5.
    # 建立 DataLoader
    # ========================================================

    (
        train_dataset,
        val_dataset,
        dummy_test_dataset,

        train_loader,
        val_loader,
        dummy_test_loader

    ) = build_final_dataloaders(

        train_df=
            internal_train_df,

        val_df=
            internal_val_df,

        # ----------------------------------------------------
        # 原本 build_final_dataloaders()
        # 需要輸入 test_df。
        #
        # 但是 Experiment 1 internal CV
        # 完全不可以碰 Outer Test 30 人。
        #
        # 所以這裡暫時把 internal validation
        # 再傳一次當 dummy test。
        #
        # dummy_test_loader 完全不會被使用。
        # ----------------------------------------------------

        test_df=
            internal_val_df.copy(),

        run_seed=
            fold_seed,

        batch_size=
            BATCH_SIZE
    )


    print(
        "Train batches =",
        len(
            train_loader
        )
    )


    print(
        "Validation batches =",
        len(
            val_loader
        )
    )


    # --------------------------------------------------------
    # Batch size = 2
    #
    # 96 Training：
    # 96 / 2 = 48 batches
    #
    # 24 Validation：
    # 24 / 2 = 12 batches
    # --------------------------------------------------------





    # ========================================================
    # 7-6.
    # 建立 V6 Model
    # ========================================================

    model = build_exp1_v6_model(

        seed=
            fold_seed,

        device=
            device,

        dropout_rate=
            DROPOUT_RATE
    )


    print(
        "Initial MaxPool =",
        model.maxpool
    )


    # --------------------------------------------------------
    # 正常一定要看到：
    #
    # Initial MaxPool = Identity()
    #
    # 如果不是 Identity，
    # 就代表不是我們要的 V6。
    # --------------------------------------------------------





    # ========================================================
    # 7-7.
    # 建立 Loss + Optimizer
    # ========================================================

    (
        criterion,
        optimizer,
        pos_weight_value

    ) = build_training_objects(

        model=
            model,

        train_df=
            internal_train_df,

        device=
            device,

        learning_rate=
            LEARNING_RATE,

        weight_decay=
            WEIGHT_DECAY
    )


    print(
        "pos_weight =",
        pos_weight_value
    )


    # --------------------------------------------------------
    # Training：
    #
    # Control = 64
    # Case    = 32
    #
    # pos_weight：
    #
    # 64 / 32 = 2
    #
    # 用來處理 1:2 class imbalance。
    # --------------------------------------------------------





    # ========================================================
    # 7-8.
    # Learning Rate Scheduler
    # ========================================================

    scheduler = (

        torch.optim.lr_scheduler
        .ReduceLROnPlateau(

            optimizer,

            mode="max",

            factor=
                LR_FACTOR,

            patience=
                LR_PATIENCE,

            min_lr=
                MIN_LEARNING_RATE
        )
    )


    # --------------------------------------------------------
    # 監控的是 Validation AUC。
    #
    # 如果沒有改善：
    #
    # Learning rate × 0.5
    # --------------------------------------------------------





    # ========================================================
    # 7-9.
    # 建立 Best-model Tracking
    # ========================================================

    best_val_auc = (
        -np.inf
    )


    best_val_loss = (
        np.inf
    )


    best_epoch = 0


    best_model_state = None


    epochs_without_improvement = 0


    history = []


    # --------------------------------------------------------
    # Best model 判斷：
    #
    # 第一順位：
    # Validation AUC 最大
    #
    # 如果 AUC 一樣：
    # Validation loss 比較小者
    # --------------------------------------------------------





    # ========================================================
    # 7-10.
    # 正式開始 Training
    # ========================================================

    for epoch in range(

        1,

        MAX_EPOCHS
        +
        1
    ):


        # ----------------------------------------------------
        # A.
        # Training 96 subjects
        # ----------------------------------------------------

        train_result = train_one_epoch(

            model=
                model,

            data_loader=
                train_loader,

            criterion=
                criterion,

            optimizer=
                optimizer,

            device=
                device
        )



        # ----------------------------------------------------
        # B.
        # Validation 24 subjects
        # ----------------------------------------------------

        (
            val_result,
            val_labels,
            val_probs,
            val_ids

        ) = evaluate_one_epoch(

            model=
                model,

            data_loader=
                val_loader,

            criterion=
                criterion,

            device=
                device
        )



        # ----------------------------------------------------
        # C.
        # 目前 Learning Rate
        # ----------------------------------------------------

        current_lr = (

            optimizer
            .param_groups[0][
                "lr"
            ]
        )





        # ====================================================
        # 7-11.
        # 儲存每個 Epoch 的結果
        # ====================================================

        history.append(
            {

                "fold":
                    fold_number,

                "epoch":
                    epoch,

                "learning_rate":
                    current_lr,

                "train_loss":
                    train_result[
                        "loss"
                    ],

                "train_auc":
                    train_result[
                        "auc"
                    ],

                "train_prob_mean":
                    train_result[
                        "prob_mean"
                    ],

                "train_prob_sd":
                    train_result[
                        "prob_sd"
                    ],

                "train_prob_min":
                    train_result[
                        "prob_min"
                    ],

                "train_prob_max":
                    train_result[
                        "prob_max"
                    ],

                "val_loss":
                    val_result[
                        "loss"
                    ],

                "val_auc":
                    val_result[
                        "auc"
                    ],

                "val_prob_mean":
                    val_result[
                        "prob_mean"
                    ],

                "val_prob_sd":
                    val_result[
                        "prob_sd"
                    ],

                "val_prob_min":
                    val_result[
                        "prob_min"
                    ],

                "val_prob_max":
                    val_result[
                        "prob_max"
                    ]
            }
        )


        # ----------------------------------------------------
        # 這裡特別留下 probability SD / min / max。
        #
        # 因為之前模型曾經出現：
        #
        # 所有人 probability 非常接近
        #
        # 的 probability collapse。
        #
        # 所以這次要一起監控。
        # --------------------------------------------------------





        # ====================================================
        # 7-12.
        # 判斷是否為目前 Best Epoch
        # ====================================================

        auc_improved = (

            val_result[
                "auc"
            ]

            >

            best_val_auc
            +
            1e-8
        )



        auc_tied_loss_improved = (

            abs(

                val_result[
                    "auc"
                ]

                -

                best_val_auc

            )

            <=
            1e-8

            and

            val_result[
                "loss"
            ]

            <

            best_val_loss
        )



        is_best = (

            auc_improved

            or

            auc_tied_loss_improved
        )





        # ====================================================
        # 7-13.
        # 如果是 Best Epoch，就保存模型
        # ====================================================

        if is_best:


            best_val_auc = (

                val_result[
                    "auc"
                ]
            )


            best_val_loss = (

                val_result[
                    "loss"
                ]
            )


            best_epoch = (
                epoch
            )


            # ------------------------------------------------
            # 把目前最佳 model weights
            # 複製到 CPU 保存。
            # ------------------------------------------------

            best_model_state = {

                key:

                    value
                    .detach()
                    .cpu()
                    .clone()

                for key, value
                in model
                .state_dict()
                .items()
            }


            epochs_without_improvement = 0



        else:


            epochs_without_improvement += 1





        # ====================================================
        # 7-14.
        # 更新 Learning Rate Scheduler
        # ====================================================

        scheduler.step(

            val_result[
                "auc"
            ]
        )





        # ====================================================
        # 7-15.
        # 顯示每個 Epoch 的結果
        # ====================================================

        print(

            f"Epoch {epoch:02d}"

            f" | LR {current_lr:.2e}"

            f" | Train loss "
            f"{train_result['loss']:.4f}"

            f" | Train AUC "
            f"{train_result['auc']:.3f}"

            f" | Val loss "
            f"{val_result['loss']:.4f}"

            f" | Val AUC "
            f"{val_result['auc']:.3f}"

            f" | Val SD "
            f"{val_result['prob_sd']:.6f}"

            f" | Best "
            f"{best_epoch}"
        )





        # ====================================================
        # 7-16.
        # Early Stopping
        # ====================================================

        if (

            epochs_without_improvement

            >=

            EARLY_STOPPING_PATIENCE
        ):


            print(
                "\nEarly stopping."
            )


            break


        # ----------------------------------------------------
        # 如果連續 5 epochs
        # Validation AUC 都沒有改善，
        #
        # 就停止 Training。
        # --------------------------------------------------------





    # ========================================================
    # 7-17.
    # Restore Best Model
    # ========================================================

    assert (
        best_model_state
        is not None
    )


    model.load_state_dict(

        best_model_state
    )


    model = model.to(
        device
    )


    model.eval()


    # --------------------------------------------------------
    # Training 結束後：
    #
    # 不使用最後一個 epoch。
    #
    # 而是回到 Validation AUC
    # 表現最好的那一個 epoch。
    # --------------------------------------------------------





    # ========================================================
    # 7-18.
    # 用 Best Model
    # 重新預測該 Fold 的 Validation subjects
    # ========================================================

    (
        best_val_result,
        best_val_labels,
        best_val_probs,
        best_val_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            val_loader,

        criterion=
            criterion,

        device=
            device
    )


    # --------------------------------------------------------
    # 這 24 人：
    #
    # 沒有被這一 fold 的模型拿去 Training。
    #
    # 所以這 24 個 predicted probabilities
    # 就是 OOF probabilities。
    # --------------------------------------------------------





    # ========================================================
    # 7-19.
    # 整理 Validation Labels / Probabilities
    # ========================================================

    best_val_labels = (

        np.asarray(
            best_val_labels
        )

        .reshape(
            -1
        )
    )


    best_val_probs = (

        np.asarray(
            best_val_probs
        )

        .reshape(
            -1
        )
    )


    best_val_ids = list(
        best_val_ids
    )





    # ========================================================
    # 7-20.
    # 建立這一 Fold 的 OOF dataframe
    # ========================================================

    oof_df = pd.DataFrame(
        {

            "psam_IID":
                best_val_ids,

            "true_label":
                best_val_labels
                .astype(
                    int
                ),

            "oof_probability":
                best_val_probs,

            "cv_fold":
                fold_number
        }
    )


    # --------------------------------------------------------
    # 內容：
    #
    # psam_IID
    # true_label
    # oof_probability
    # cv_fold
    # --------------------------------------------------------





    # ========================================================
    # 7-21.
    # 計算這一 Fold 的 OOF AUC

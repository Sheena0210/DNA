# 5. 建立每一個 model 的 Training-reference mean / SD
#
# 每一個 Repeat × Fold：
#
# Training 96 subjects
#
# mean = μ_train
# SD   = σ_train
#
# 使用 sample SD：
#
# ddof = 1
# ============================================================

training_reference_stats = (

    matched_trainref

    .groupby(
        [
            "repeat",
            "fold"
        ]
    )

    .agg(

        n_train=(
            "train_reference_logit",
            "size"
        ),

        train_logit_mean=(
            "train_reference_logit",
            "mean"
        ),

        train_logit_sd=(
            "train_reference_logit",
            lambda x:
                x.std(
                    ddof=1
                )
        ),

        train_logit_min=(
            "train_reference_logit",
            "min"
        ),

        train_logit_max=(
            "train_reference_logit",
            "max"
        )
    )

    .reset_index()
)




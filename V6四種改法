# ============================================================
# 14. Function：
# Given threshold → classification metrics
# ============================================================

def calculate_binary_metrics(
    labels,
    scores,
    threshold
):


    labels = np.asarray(
        labels,
        dtype=int
    )


    scores = np.asarray(
        scores,
        dtype=float
    )



    # --------------------------------------------------------
    # Case prediction：
    #
    # Z >= threshold
    # --------------------------------------------------------

    predictions = (

        scores
        >=
        threshold

    ).astype(int)



    TP = int(
        (
            (predictions == 1)
            &
            (labels == 1)
        )
        .sum()
    )


    FN = int(
        (
            (predictions == 0)
            &
            (labels == 1)
        )
        .sum()
    )


    TN = int(
        (
            (predictions == 0)
            &
            (labels == 0)
        )
        .sum()
    )


    FP = int(
        (
            (predictions == 1)
            &
            (labels == 0)
        )
        .sum()
    )



    # --------------------------------------------------------
    # Metrics
    # --------------------------------------------------------

    sensitivity = (

        TP
        /
        (TP + FN)

        if (TP + FN) > 0

        else np.nan
    )


    specificity = (

        TN
        /
        (TN + FP)

        if (TN + FP) > 0

        else np.nan
    )


    PPV = (

        TP
        /
        (TP + FP)

        if (TP + FP) > 0

        else np.nan
    )


    NPV = (

        TN
        /
        (TN + FN)

        if (TN + FN) > 0

        else np.nan
    )


    accuracy = (

        (TP + TN)
        /
        len(labels)
    )


    balanced_accuracy = (

        (
            sensitivity
            +
            specificity
        )
        /
        2
    )


    youden_j = (

        sensitivity
        +
        specificity
        -
        1
    )


    sens_spec_gap = abs(

        sensitivity
        -
        specificity
    )



    return {

        "threshold":
            float(
                threshold
            ),

        "TP":
            TP,

        "FN":
            FN,

        "TN":
            TN,

        "FP":
            FP,

        "sensitivity":
            sensitivity,

        "specificity":
            specificity,

        "PPV":
            PPV,

        "NPV":
            NPV,

        "accuracy":
            accuracy,

        "balanced_accuracy":
            balanced_accuracy,

        "youden_j":
            youden_j,

        "sens_spec_gap":
            sens_spec_gap
    }



# ============================================================
# 15. 建立 threshold candidates
#
# 直接使用 subject mean Z 的 unique values。
#
# Classification rule：
#
# Z >= threshold → Case
# ============================================================

subject_scores = (

    subject_logit_z[
        "mean_trainref_logit_z"
    ]

    .to_numpy(
        dtype=float
    )
)


subject_labels = (

    subject_logit_z[
        "true_label"
    ]

    .to_numpy(
        dtype=int
    )
)



unique_scores = np.sort(

    np.unique(
        subject_scores
    )
)



# ------------------------------------------------------------
# 加入一個 max 以上 threshold，
# 讓 all-negative 也能被評估。
# ------------------------------------------------------------

threshold_candidates = np.concatenate(
    [

        unique_scores,

        [
            np.nextafter(
                unique_scores.max(),
                np.inf
            )
        ]
    ]
)



# ============================================================
# 16. Evaluate every threshold
# ============================================================

threshold_results = []


for threshold in threshold_candidates:


    threshold_results.append(

        calculate_binary_metrics(

            labels=
                subject_labels,

            scores=
                subject_scores,

            threshold=
                threshold
        )
    )



threshold_table = pd.DataFrame(

    threshold_results
)



# ============================================================
# 17. Primary threshold selection
#
# Rule:
#
# 1. maximum Balanced Accuracy
#
# 2. tie →
#    minimum |Sensitivity - Specificity|
#
# 3. still tie →
#    threshold closest to 0
#
# 為了 deterministic，
# 最後再 threshold ascending。
# ============================================================

threshold_table[
    "abs_threshold"
] = (

    threshold_table[
        "threshold"
    ]
    .abs()
)



threshold_table_ranked = (

    threshold_table

    .sort_values(

        by=[
            "balanced_accuracy",
            "sens_spec_gap",
            "abs_threshold",
            "threshold"
        ],

        ascending=[
            False,
            True,
            True,
            True
        ]
    )

    .reset_index(
        drop=True
    )
)




# ============================================================
# 5. Metric function
# ============================================================

def calculate_threshold_metrics(
    labels,
    scores,
    threshold
):


    labels = np.asarray(
        labels
    ).astype(
        int
    )


    scores = np.asarray(
        scores
    ).astype(
        float
    )


    # --------------------------------------------------------
    # Score >= threshold
    # → predict Case
    # --------------------------------------------------------

    predictions = (

        scores
        >=
        threshold

    ).astype(
        int
    )


    TP = int(

        (
            (labels == 1)
            &
            (predictions == 1)
        )
        .sum()
    )


    FN = int(

        (
            (labels == 1)
            &
            (predictions == 0)
        )
        .sum()
    )


    TN = int(

        (
            (labels == 0)
            &
            (predictions == 0)
        )
        .sum()
    )


    FP = int(

        (
            (labels == 0)
            &
            (predictions == 1)
        )
        .sum()
    )


    sensitivity = (

        TP
        /
        (TP + FN)

        if
        (TP + FN)
        >
        0

        else
        np.nan
    )


    specificity = (

        TN
        /
        (TN + FP)

        if
        (TN + FP)
        >
        0

        else
        np.nan
    )


    ppv = (

        TP
        /
        (TP + FP)

        if
        (TP + FP)
        >
        0

        else
        np.nan
    )


    npv = (

        TN
        /
        (TN + FN)

        if
        (TN + FN)
        >
        0

        else
        np.nan
    )


    accuracy = (

        (TP + TN)
        /
        len(
            labels
        )
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    youden_j = (

        sensitivity
        +
        specificity
        -
        1
    )


    sens_spec_gap = abs(

        sensitivity
        -
        specificity
    )


    return {

        "threshold":
            threshold,

        "TN":
            TN,

        "FP":
            FP,

        "FN":
            FN,

        "TP":
            TP,

        "accuracy":
            accuracy,

        "sensitivity":
            sensitivity,

        "specificity":
            specificity,

        "PPV":
            ppv,

        "NPV":
            npv,

        "balanced_accuracy":
            balanced_accuracy,

        "youden_j":
            youden_j,

        "sens_spec_gap":
            sens_spec_gap
    }



# ============================================================
# 6. 建立所有有意義的 Threshold Candidates
# ============================================================

def create_threshold_candidates(
    scores
):


    unique_scores = np.sort(

        np.unique(
            scores
        )
    )


    # --------------------------------------------------------
    # 相鄰 score 的 midpoint
    #
    # 只要 threshold 位在兩個 score 中間，
    # classification result 就完全一樣。
    # --------------------------------------------------------

    midpoints = (

        unique_scores[:-1]
        +
        unique_scores[1:]

    ) / 2


    # --------------------------------------------------------
    # 加上兩端：
    #
    # below minimum
    # above maximum
    # --------------------------------------------------------

    epsilon = max(

        np.finfo(
            float
        ).eps,

        (
            unique_scores[
                -1
            ]
            -
            unique_scores[
                0
            ]
        )
        *
        1e-6
    )


    candidates = np.concatenate(
        [

            [
                unique_scores[
                    0
                ]
                -
                epsilon
            ],

            midpoints,

            [
                unique_scores[
                    -1
                ]
                +
                epsilon
            ]
        ]
    )


    return candidates



# ============================================================
# 7. 正式掃描 Threshold
# ============================================================


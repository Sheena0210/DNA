    fold_val_df,
    run_seed
):


    # --------------------------------------------------------
    # 原本 helper 會建立：
    #
    # Train dataset
    # Validation-style dataset
    # Test-style dataset
    #
    # 我們利用：
    #
    # train_df = Training 96
    #
    # val_df   = Training 96
    #   → deterministic training-reference
    #
    # test_df  = Validation 24
    #   → internal validation
    # --------------------------------------------------------

    (
        base_train_dataset,
        base_train_eval_dataset,
        base_val_dataset,

        _,
        _,
        _

    ) = build_final_dataloaders(

        train_df=
            fold_train_df,

        val_df=
            fold_train_df,

        test_df=
            fold_val_df,

        run_seed=
            run_seed,

        batch_size=2
    )



    # --------------------------------------------------------
    # Training：
    # matched groups shuffle
    # --------------------------------------------------------

    train_batch_sampler = (

        MatchedGroupBatchSampler(

            base_dataset=
                base_train_dataset,

            metadata_df=
                fold_train_df,

            shuffle=True,

            seed=
                run_seed
        )
    )



    # --------------------------------------------------------
    # Training-reference：
    # deterministic
    # --------------------------------------------------------

    train_eval_batch_sampler = (

        MatchedGroupBatchSampler(

            base_dataset=
                base_train_eval_dataset,

            metadata_df=
                fold_train_df,

            shuffle=False,

            seed=
                run_seed
        )
    )



    # --------------------------------------------------------
    # Validation：
    # deterministic
    # --------------------------------------------------------

    val_batch_sampler = (

        MatchedGroupBatchSampler(

            base_dataset=
                base_val_dataset,

            metadata_df=
                fold_val_df,

            shuffle=False,

            seed=
                run_seed
        )
    )



    # --------------------------------------------------------
    # DataLoaders
    #
    # 不指定 batch_size，
    # 因為 batch_sampler 已經決定：
    #
    # batch = 3 subjects
    # --------------------------------------------------------

    train_loader = DataLoader(

        base_train_dataset,

        batch_sampler=
            train_batch_sampler,

        num_workers=0
    )


    train_eval_loader = DataLoader(

        base_train_eval_dataset,

        batch_sampler=
            train_eval_batch_sampler,

        num_workers=0
    )


    val_loader = DataLoader(

        base_val_dataset,

        batch_sampler=
            val_batch_sampler,

        num_workers=0
    )


    return (

        base_train_dataset,
        base_train_eval_dataset,
        base_val_dataset,

        train_batch_sampler,
        train_eval_batch_sampler,
        val_batch_sampler,

        train_loader,
        train_eval_loader,

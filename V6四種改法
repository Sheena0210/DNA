# ============================================================
# STEP 8
# Threshold function
# ============================================================

def calculate_threshold_metrics(
    y_true,
    score,
    threshold
):


    y_true = np.asarray(
        y_true
    ).astype(int)


    score = np.asarray(
        score
    ).astype(float)


    y_pred = (
        score
        >=
        threshold
    ).astype(int)



    tn, fp, fn, tp = confusion_matrix(

        y_true,
        y_pred,

        labels=[
            0,
            1
        ]

    ).ravel()



    sensitivity = (

        tp
        /
        (tp + fn)

        if
        (tp + fn) > 0

        else
        np.nan
    )


    specificity = (

        tn
        /
        (tn + fp)

        if
        (tn + fp) > 0

        else
        np.nan
    )


    balanced_accuracy = (

        sensitivity
        +
        specificity

    ) / 2


    accuracy = (

        tp + tn
    ) / (

        tp + tn + fp + fn
    )


    ppv = (

        tp
        /
        (tp + fp)

        if
        (tp + fp) > 0

        else
        np.nan
    )


    npv = (

        tn
        /
        (tn + fn)

        if
        (tn + fn) > 0

        else
        np.nan
    )


    youden_j = (

        sensitivity
        +
        specificity
        -
        1
    )


    sens_spec_gap = abs(

        sensitivity
        -
        specificity
    )



    return {

        "threshold":
            float(
                threshold
            ),

        "sensitivity":
            float(
                sensitivity
            ),

        "specificity":
            float(
                specificity
            ),

        "balanced_accuracy":
            float(
                balanced_accuracy
            ),

        "accuracy":
            float(
                accuracy
            ),

        "ppv":
            float(
                ppv
            ),

        "npv":
            float(
                npv
            ),

        "youden_j":
            float(
                youden_j
            ),

        "sens_spec_gap":
            float(
                sens_spec_gap
            ),

        "tn":
            int(
                tn
            ),

        "fp":
            int(
                fp
            ),

        "fn":
            int(
                fn
            ),

        "tp":
            int(
                tp
            )
    }



# ============================================================

# ============================================================
# 9. 準備 Training reference table
# ============================================================

training_reference = (

    fold_summary[
        [
            "repeat",
            "fold",
            "train_prob_mean",
            "train_prob_sd",
            "val_prob_mean",
            "val_prob_sd"
        ]
    ]

    .rename(
        columns={
            "fold":
                "cv_fold"
        }
    )
)



# ============================================================
# 10. 把 Training Mean / SD 合併到每筆 OOF prediction
# ============================================================

oof_trainref = (

    oof

    .merge(

        training_reference,

        on=[
            "repeat",
            "cv_fold"
        ],

        how="left",

        validate="many_to_one"
    )
)


assert (

    oof_trainref[
        "train_prob_mean"
    ]
    .notna()
    .all()
)


assert (

    oof_trainref[
        "train_prob_sd"
    ]
    .notna()
    .all()
)



# ============================================================
# 11. 建立 Training-reference Centered Score
# ============================================================

oof_trainref[
    "trainref_centered_score"
] = (

    oof_trainref[
        "oof_probability"
    ]

    -

    oof_trainref[
        "train_prob_mean"
    ]
)



# ============================================================
# 12. 建立 Training-reference Z-score
# ============================================================

oof_trainref[
    "trainref_z_score"
] = (

    oof_trainref[
        "trainref_centered_score"
    ]

    /

    oof_trainref[
        "train_prob_sd"
    ]
)


# ------------------------------------------------------------
# 公式：
#
#                  Validation subject probability
#                        -
#                  Training probability mean
#
# trainref Z = ----------------------------------
#
#                  Training probability SD
#
#
# 正值：
#
# 該 validation subject 的 prediction
# 高於 Training population baseline
#
#
# 負值：
#
# 低於 Training population baseline
# ------------------------------------------------------------



# ============================================================
# 13. 同時重新建立 Validation-reference Z-score
#
# 用來和 Train-reference 比較
# ============================================================

oof_trainref[
    "valref_z_score"
] = (

    (
        oof_trainref[
            "oof_probability"
        ]

        -

        oof_trainref[
            "val_prob_mean"
        ]
    )

    /

    oof_trainref[
        "val_prob_sd"
    ]
)



# ============================================================
# 14. 如果原 OOF 沒有 percentile_rank，
# 重新建立
# ============================================================

if "percentile_rank" not in oof_trainref.columns:


    oof_trainref[
        "percentile_rank"
    ] = (

        oof_trainref

        .groupby(
            [
                "repeat",
                "cv_fold"
            ]
        )

        [
            "oof_probability"
        ]

        .rank(

            method="average",

            pct=True
        )
    )



# ============================================================
# 15. 每一個 Model：
# 檢查 Training vs Validation baseline 差多少
# ============================================================

fold_reference_comparison = (

    fold_summary[
        [
            "repeat",
            "fold",
            "train_prob_mean",
            "train_prob_sd",
            "val_prob_mean",
            "val_prob_sd",
            "train_auc",
            "val_auc"
        ]
    ]

    .copy()
)


fold_reference_comparison[
    "val_minus_train_mean"
] = (

    fold_reference_comparison[
        "val_prob_mean"
    ]

    -

    fold_reference_comparison[
        "train_prob_mean"
    ]
)


fold_reference_comparison[
    "mean_shift_in_train_sd"
] = (

    fold_reference_comparison[
        "val_minus_train_mean"
    ]

    /

    fold_reference_comparison[
        "train_prob_sd"
    ]
)



print(
    "\n"
    +
    "=" * 120
)

print(
    "TRAINING vs VALIDATION PROBABILITY REFERENCE"
)

print(
    "=" * 120

#
#
#   Matched loss：
#
#   L = -log P(case | matched set)
#
#
#   等價於：
#
#   L = -s_case + logsumexp(
#           s_case,
#           s_control1,
#           s_control2
#       )
#
#
# 模型要學習：
#
#       s_case > s_control1
#       s_case > s_control2
#
#


# ============================================================
# 2. 建立安全的PNG檔名
# ============================================================
#
# 如果sample ID含有：
#
# /
# :
# 空白
# 或其他特殊符號
#
# 可能影響檔案路徑。
#
# 所以只保留：
#
# 英文字母
# 數字
# -
# _
# .
# ============================================================

def make_safe_filename(sample_id):

    sample_id = str(
        sample_id
    )

    safe_id = re.sub(
        r"[^A-Za-z0-9_.-]",
        "_",
        sample_id
    )

    return safe_id



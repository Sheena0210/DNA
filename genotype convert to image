from pathlib import Path
from PIL import Image
import numpy as np
import re

# ------------------------------------------------------------
# 1. 建立PNG輸出資料夾
# ------------------------------------------------------------

png_output_dir = Path(
    "/Users/sheenazhengmei/Desktop/"

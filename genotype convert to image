def get_encoding_codes_for_variant(
    ref,
    alt
):
    """
    回傳：
        code_refref
        code_refalt
        code_altalt

    如果REF或ALT不是A/C/G/T，
    三種都回NoCall = 7。
    """

    ref = str(ref).upper()
    alt = str(alt).upper()

    valid_bases = {
        "A",
        "C",
        "G",
        "T"
    }


    #非ACGT variant
    if (
        ref not in valid_bases
        or
        alt not in valid_bases
    ):

        return 7, 7, 7


    #REF/REF
    genotype_refref = "".join(
        sorted(
            [ref, ref]
        )
    )


    #REF/ALT
    genotype_refalt = "".join(
        sorted(
            [ref, alt]
        )
    )


    #ALT/ALT
    genotype_altalt = "".join(
        sorted(
            [alt, alt]
        )
    )


    return (
        genotype_to_code[
            genotype_refref
        ],

        genotype_to_code[
            genotype_refalt
        ],

        genotype_to_code[
            genotype_altalt
        ]
    )


#
# 這次不是從左上角開始，
# 而是改成從中心開始，方向依序：
#
# 右 -> 下 -> 左 -> 上
#
# 然後一圈一圈向外擴張。
#
# 注意：
# 720 是偶數，所以沒有單一中心點，
# 中央其實有 4 個格子。
#
# 這裡固定使用「中央四格中的左上角」作為起點：
# Python 0-based index = (359, 359)
#
# 若之後你想改成中央四格中的其他一格，
# 只要改 start_row / start_col 即可。
# ============================================================

import math
import numpy as np
import pandas as pd
# ------------------------------------------------------------
# 1. SNP總數

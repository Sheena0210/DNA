            "group_id",
            "nunique"
        ),

        n_cases=(
            "label",
            "sum"
        )
    )
    .reset_index()
)


fold_qc[
    "n_controls"
] = (
    fold_qc[
        "n_subjects"
    ]
    -
    fold_qc[
        "n_cases"
    ]
)


print(
    fold_qc.to_string(
        index=False
    )
)

# ============================================================
# 10. Relatedness QC
# ============================================================

related_qc = (
    dataset_manifest[
        dataset_manifest[
            "group_id"
        ].isin(
            related_groups
        )
    ][
        [
            "psam_IID",
            "group_id",
            "label",
            "fold_new"
        ]
    ]
    .sort_values(
        [
            "group_id",

# V4：ResNet18 + GroupNorm
#     Average Pooling + Flatten
# ============================================================
#
# V3：
# 512 × 23 × 23
# ↓
# Global Average Pooling
# ↓
# 512 × 1 × 1
# ↓
# Flatten
# ↓
# 512 features
#
#
# V4：
# 512 × 23 × 23
# ↓
# Average Pooling
# kernel = 5
# stride = 5
# ↓
# 512 × 4 × 4
# ↓
# Flatten
# ↓
# 8192 features
#
# ============================================================

def build_resnet18_v4_model(
    seed,
    device,
    dropout_rate=0.5
):

    # --------------------------------------------------------
    # Reproducibility
    # --------------------------------------------------------

    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)


    # --------------------------------------------------------
    # 保留V3的GroupNorm
    # --------------------------------------------------------

    model = models.resnet18(

        weights=None,

        norm_layer=group_norm_layer
    )


    # --------------------------------------------------------
    # V3原本：
    #
    # AdaptiveAvgPool2d((1,1))
    #
    # V4改成：
    #
    # AvgPool2d(kernel=5, stride=5)
    #
    # 23×23 → 4×4
    # --------------------------------------------------------

    model.avgpool = nn.AvgPool2d(

        kernel_size=5,

        stride=5
    )


    # --------------------------------------------------------
    # Pooling後：
    #
    # 512 × 4 × 4
    #
    # Flatten：
    #
    # 512 × 4 × 4 = 8192
    # --------------------------------------------------------

    n_features = (
        512
        *
        4
        *
        4
    )


    # --------------------------------------------------------
    # classifier
    #
    # 仍然保留V3：
    # Dropout = 0.5
    # --------------------------------------------------------

    model.fc = nn.Sequential(

        nn.Dropout(
            p=dropout_rate
        ),

        nn.Linear(
            n_features,
            1
        )
    )


    model = model.to(
        device
    )


    return model

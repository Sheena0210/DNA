    # ========================================================

    (
        train_eval_result,
        train_labels,
        train_probs,
        train_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            train_loader,

        criterion=
            criterion,

        device=
            device
    )


    train_roc_auc = roc_auc_score(

        train_labels,

        train_probs
    )


    # ========================================================
    # 9. Evaluation 60
    # ========================================================

    (
        eval_result,
        eval_labels,
        eval_probs,
        eval_ids

    ) = evaluate_one_epoch(

        model=
            model,

        data_loader=
            eval_loader,

        criterion=
            criterion,

        device=
            device
    )


    eval_roc_auc = roc_auc_score(

        eval_labels,

        eval_probs
    )


    # ========================================================
    # 10. Prediction dataframe
    # ========================================================

    eval_predictions_df = pd.DataFrame(
        {
            "psam_IID":
                eval_ids,

            "true_label":
                eval_labels.astype(int),

            "pred_probability":
                eval_probs
        }
    )


    eval_predictions_df = (
        eval_predictions_df
        .merge(
            eval60_df[
                [
                    "psam_IID",
                    "group_id",
                    "case_control"
                ]
            ],
            on="psam_IID",
            how="left"
        )
    )


    eval_predictions_df[
        "run"
    ] = run_number


    # ========================================================
    # 11. Summary
    # ========================================================

    print(
        "\n"
        +
        "-" * 75
    )

    print(
        f"V7 Run {run_number} finished"
    )

    print(
        f"Training ROC-AUC   = {train_roc_auc:.4f}"
    )

    print(
        f"Evaluation ROC-AUC = {eval_roc_auc:.4f}"
    )

    print(
        f"Eval prob mean     = {eval_result['prob_mean']:.6f}"
    )

    print(
        f"Eval prob SD       = {eval_result['prob_sd']:.6f}"
    )

    print(
        f"Eval prob min      = {eval_result['prob_min']:.6f}"
    )

    print(

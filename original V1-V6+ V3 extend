def train_v7_run(
    dataset_manifest,
    run_number,
    device,
    base_seed=20260910,
    batch_size=2,
    dropout_rate=0.5,
    learning_rate=5e-5,
    weight_decay=1e-3,
    fixed_epochs=3
):

    # ========================================================
    # 1. Seed
    # ========================================================

    run_seed = (
        base_seed
        +
        run_number
        -
        1
    )


    random.seed(run_seed)
    np.random.seed(run_seed)
    torch.manual_seed(run_seed)


    print(
        "\n"
        +
        "=" * 75
    )

    print(
        f"V7 | TRAIN 90 / EVALUATION 60 | RUN {run_number}"
    )


# ============================================================
# V3 Reverse Diagnostic V2
#
# Original:
# Train = 90
# Val   = 30
# Test  = 30
#
# Reverse:
# Train = original Test = 30
# Test  = original Train = 90
#
# Original Validation:
# 只為了 build_final_dataloaders() 建 loader
# 不參與 training / model selection / evaluation
# ============================================================

import random
import numpy as np
import pandas as pd
import torch

from sklearn.metrics import (
    roc_auc_score,
    confusion_matrix,
    accuracy_score
)


def train_v3_reverse_run_v2(
    dataset_manifest,
    original_run,
    device,
    batch_size=2,
    dropout_rate=0.5,
    learning_rate=5e-5,
    weight_decay=1e-3,
    threshold=0.5
):

    # ========================================================
    # 1. Run information
    # ========================================================

    run_number = original_run["run"]
    run_seed = original_run["run_seed"]

    # 固定使用原本 V3 已選好的 best epoch
    # 不使用 reverse test data 選 epoch
    fixed_epochs = int(
        original_run["best_epoch"]
    )

    random.seed(run_seed)
    np.random.seed(run_seed)
    torch.manual_seed(run_seed)

    print("\n" + "=" * 70)
    print(
        f"V3 REVERSE DIAGNOSTIC V2 | RUN {run_number}"
    )
    print(f"Run seed     = {run_seed}")
    print(f"Fixed epochs = {fixed_epochs}")
    print("=" * 70)


    # ========================================================
    # 2. 重新從「已修正路徑的 dataset_manifest」取得原始 split
    # ========================================================

    (
        original_train_df,
        original_val_df,
        original_test_df

    ) = get_final_cv_split(

        dataset_manifest,

        run_number=run_number
    )


    # ========================================================
    # 3. Reverse
    # ========================================================

    reverse_train_df = (
        original_test_df
        .copy()
        .reset_index(drop=True)
    )

    reverse_test_df = (
        original_train_df
        .copy()
        .reset_index(drop=True)
    )

    unused_val_df = (
        original_val_df
        .copy()
        .reset_index(drop=True)
    )


    print(
        f"Reverse Train = {len(reverse_train_df)}"
    )

    print(
        f"Reverse Test  = {len(reverse_test_df)}"
    )

    print(
        f"Unused Val    = {len(unused_val_df)}"
    )


    print("\nReverse Train:")
    print(
        reverse_train_df[
            "case_control"
        ].value_counts()
    )

    print("\nReverse Test:")
    print(
        reverse_test_df[
            "case_control"
        ].value_counts()
    )


    # ========================================================
    # 4. Matched-group QC
    # ========================================================

    train_groups = set(
        reverse_train_df["group_id"]
    )

    test_groups = set(
        reverse_test_df["group_id"]
    )

    val_groups = set(
        unused_val_df["group_id"]
    )


    assert len(
        train_groups & test_groups
    ) == 0

    assert len(
        train_groups & val_groups
    ) == 0

    assert len(
        test_groups & val_groups
    ) == 0


    assert (
        reverse_train_df
        .groupby("group_id")
        .size()
        .eq(3)
        .all()
    )

    assert (
        reverse_test_df
        .groupby("group_id")
        .size()
        .eq(3)
        .all()
    )

    print(
        "\nMatched-group QC PASSED"
    )


    # ========================================================
    # 5. 再次確認這個 run 使用的 PNG 全部存在
    # ========================================================

    import os

    assert (
        reverse_train_df["png_file"]
        .apply(os.path.exists)
        .all()
    )

    assert (
        reverse_test_df["png_file"]
        .apply(os.path.exists)
        .all()
    )

    print(
        "PNG path QC PASSED"
    )


    # ========================================================
    # 6. 重新建立 Dataset + DataLoader
    #
    # 注意：
    # unused_val_df 只是因為原本 helper function
    # 需要 train / val / test 三個 dataframe
    #
    # 後面完全不使用 val_loader
    # ========================================================

    (
        reverse_train_dataset,
        unused_val_dataset,
        reverse_test_dataset,

        reverse_train_loader,
        unused_val_loader,
        reverse_test_loader

    ) = build_final_dataloaders(

        train_df=reverse_train_df,

        val_df=unused_val_df,

        test_df=reverse_test_df,

        run_seed=run_seed,

        batch_size=batch_size
    )


    # ========================================================
    # 7. 建立全新的 V3 GroupNorm ResNet18
    # ========================================================

    model = build_resnet18_v3_model(

        seed=run_seed,

        device=device,

        dropout_rate=dropout_rate
    )


    # ========================================================
    # 8. Loss + Optimizer
    #
    # pos_weight 根據 Reverse Train 重新計算
    # ========================================================

    (
        criterion,
        optimizer,
        pos_weight_value

    ) = build_training_objects(

        model=model,

        train_df=reverse_train_df,

        device=device,

        learning_rate=learning_rate,

        weight_decay=weight_decay
    )


    print(
        f"pos_weight = {pos_weight_value:.4f}"
    )


    # ========================================================
    # 9. 取得原本 V3 learning-rate history
    # ========================================================

    original_history = original_run["history"]

    if not isinstance(
        original_history,
        pd.DataFrame
    ):

        original_history = pd.DataFrame(
            original_history
        )


    reverse_history = []


    # ========================================================
    # 10. Fixed-epoch training
    #
    # 沒有 validation
    # 沒有 early stopping
    # 沒有用 test 選 model
    # ========================================================

    for epoch in range(
        1,
        fixed_epochs + 1
    ):

        # ----------------------------------------------------
        # 沿用原本 V3 該 epoch 的 learning rate
        # ----------------------------------------------------

        epoch_record = (
            original_history[
                original_history["epoch"]
                ==
                epoch
            ]
        )

        if len(epoch_record) > 0:

            lr_now = float(
                epoch_record[
                    "learning_rate"
                ].iloc[0]
            )

        else:

            lr_now = learning_rate


        for param_group in (
            optimizer.param_groups
        ):

            param_group[
                "lr"
            ] = lr_now


        # ----------------------------------------------------
        # Train
        # ----------------------------------------------------

        train_result = train_one_epoch(

            model=model,

            data_loader=reverse_train_loader,

            criterion=criterion,

            optimizer=optimizer,

            device=device
        )


        reverse_history.append(
            {
                "run":
                    run_number,

                "epoch":
                    epoch,

                "learning_rate":
                    lr_now,

                "train_loss":
                    train_result["loss"],

                "train_auc":
                    train_result["auc"]
            }
        )


        print(
            f"Epoch {epoch:02d}"
            f" | LR {lr_now:.2e}"
            f" | Train loss = "
            f"{train_result['loss']:.4f}"
            f" | Train AUC = "
            f"{train_result['auc']:.3f}"
        )


    # ========================================================
    # 11. Training 結束後才 evaluate
    # ========================================================

    (
        final_train_result,
        train_labels,
        train_probs,
        train_ids

    ) = evaluate_one_epoch(

        model=model,

        data_loader=reverse_train_loader,

        criterion=criterion,

        device=device
    )


    (
        final_test_result,
        test_labels,
        test_probs,
        test_ids

    ) = evaluate_one_epoch(

        model=model,

        data_loader=reverse_test_loader,

        criterion=criterion,

        device=device
    )


    # ========================================================
    # 12. AUC
    # ========================================================

    train_auc = roc_auc_score(
        train_labels,
        train_probs
    )

    test_auc = roc_auc_score(
        test_labels,
        test_probs
    )


    # ========================================================
    # 13. Threshold = 0.5
    # ========================================================

    test_pred = (
        test_probs >= threshold
    ).astype(int)


    tn, fp, fn, tp = confusion_matrix(

        test_labels,

        test_pred,

        labels=[0, 1]

    ).ravel()


    sensitivity = (
        tp / (tp + fn)
        if (tp + fn) > 0
        else np.nan
    )

    specificity = (
        tn / (tn + fp)
        if (tn + fp) > 0
        else np.nan
    )

    ppv = (
        tp / (tp + fp)
        if (tp + fp) > 0
        else np.nan
    )

    npv = (
        tn / (tn + fn)
        if (tn + fn) > 0
        else np.nan
    )

    accuracy = accuracy_score(
        test_labels,
        test_pred
    )

    balanced_accuracy = (
        sensitivity + specificity
    ) / 2


    # ========================================================
    # 14. Summary
    # ========================================================

    summary = {

        "run":
            run_number,

        "fixed_epochs":
            fixed_epochs,

        "reverse_train_n":
            len(reverse_train_df),

        "reverse_test_n":
            len(reverse_test_df),

        "train_auc":
            float(train_auc),

        "test_auc":
            float(test_auc),

        "accuracy":
            float(accuracy),

        "balanced_accuracy":
            float(balanced_accuracy),

        "sensitivity":
            float(sensitivity),

        "specificity":
            float(specificity),

        "PPV":
            float(ppv),

        "NPV":
            float(npv),

        "TN":
            int(tn),

        "FP":
            int(fp),

        "FN":
            int(fn),

        "TP":
            int(tp),

        "prob_mean":
            float(
                np.mean(test_probs)
            ),

        "prob_sd":
            float(
                np.std(test_probs)
            ),

        "prob_min":
            float(
                np.min(test_probs)
            ),

        "prob_max":
            float(
                np.max(test_probs)
            )
    }


    print(
        "\n===== REVERSE TEST RESULT ====="
    )

    print(
        pd.DataFrame(
            [summary]
        ).to_string(
            index=False
        )
    )


    return {

        "summary":
            summary,

        "model":
            model,

        "criterion":
            criterion,

        "history":
            pd.DataFrame(
                reverse_history
            ),

        "train_df":
            reverse_train_df,

        "test_df":
            reverse_test_df,

        "train_labels":
            train_labels,

        "train_probs":
            train_probs,

        "test_labels":
            test_labels,

        "test_probs":
            test_probs,

        "test_ids":
            test_ids
    }
v3_reverse_runs = []

for original_run in final_v3_runs:


import random
import numpy as np
import torch
import torch.nn as nn
from torchvision import models


# ------------------------------------------------------------
# GroupNorm
# ------------------------------------------------------------

def group_norm_layer(
    num_channels
):

    return nn.GroupNorm(
        num_groups=32,
        num_channels=num_channels
    )


# ------------------------------------------------------------
# V5 model
# ------------------------------------------------------------

def build_resnet18_v5_model(
    seed,
    device,
    dropout_rate=0.5
):

    # Reproducibility
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)


    # ResNet18 + GroupNorm
    model = models.resnet18(

        weights=None,

        norm_layer=group_norm_layer
    )


    # --------------------------------------------------------
    # 移除ResNet18最後的Global Average Pooling
    #
    # 原本：
    # AdaptiveAvgPool2d((1,1))
    #
    # 現在：
    # Identity()
    # --------------------------------------------------------

    model.avgpool = nn.Identity()


    # --------------------------------------------------------
    # 720×720 input時：
    #
    # 最後feature map：
    # 512 × 23 × 23
    #
    # ResNet forward本身會：
    # torch.flatten(x, 1)
    #
    # 所以得到：
    # 270,848 features
    # --------------------------------------------------------

    n_features = (
        512
        *
        23
        *
        23
    )


    # --------------------------------------------------------
    # Classifier
    # --------------------------------------------------------

    model.fc = nn.Sequential(

        nn.Dropout(
            p=dropout_rate
        ),

        nn.Linear(
            n_features,
            1
        )
    )


    model = model.to(
        device
    )


    return model

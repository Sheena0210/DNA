def normalize_subject_id(x):

    if pd.isna(x):
        return pd.NA

    s = str(x).strip().upper()

    s = re.sub(
        r"\s+",
        "",
        s
    )

    compact = re.sub(
        r"[-_]",
        "",
        s
    )

    match = re.fullmatch(
        r"([A-Z]+)(\d{2})(\d{5})",
        compact
    )

    if match is not None:

        return (
            f"{match.group(1)}"
            f"{match.group(2)}"
            f"-"
            f"{match.group(3)}"
        )

    return compact



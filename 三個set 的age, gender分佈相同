# Metric function
# ============================================================

def z_metrics(
    y_true,
    scores,
    threshold
):

    y_true = np.asarray(
        y_true,
        dtype=int
    )

    scores = np.asarray(
        scores,
        dtype=float
    )


    y_pred = (
        scores
        >=
        threshold
    ).astype(int)


    tp = int(
        np.sum(
            (y_true == 1)
            &
            (y_pred == 1)
        )
    )

    fn = int(
        np.sum(
            (y_true == 1)
            &
            (y_pred == 0)
        )
    )

    tn = int(
        np.sum(
            (y_true == 0)
            &
            (y_pred == 0)
        )
    )

    fp = int(
        np.sum(
            (y_true == 0)
            &
            (y_pred == 1)
        )
    )


    sensitivity = (
        tp / (tp + fn)
        if
        (tp + fn) > 0
        else
        np.nan
    )


    specificity = (
        tn / (tn + fp)
        if
        (tn + fp) > 0
        else
        np.nan
    )


    accuracy = (
        (tp + tn)
        /
        len(y_true)
    )


    balanced_accuracy = (
        sensitivity
        +
        specificity
    ) / 2


    ppv = (
        tp / (tp + fp)
        if
        (tp + fp) > 0
        else
        np.nan
    )


    npv = (
        tn / (tn + fn)
        if
        (tn + fn) > 0
        else
        np.nan
    )


    auc = roc_auc_score(
        y_true,
        scores
    )


    return {
        "AUC":
            auc,

        "Accuracy":
            accuracy,

        "Sensitivity":
            sensitivity,

        "Specificity":
            specificity,

        "Balanced_Accuracy":
            balanced_accuracy,

        "PPV":
            ppv,

        "NPV":
            npv,

        "TP":
            tp,

        "FN":
            fn,

        "TN":
            tn,

        "FP":
            fp
    }


# ============================================================
# STEP 10
# Threshold selection
# ============================================================

def select_z_threshold(
    y_true,
    scores
):

    y_true = np.asarray(
        y_true,
        dtype=int
    )

    scores = np.asarray(
        scores,
        dtype=float
    )


    unique_scores = np.sort(
        np.unique(
            scores
        )
    )


    midpoints = (
        unique_scores[:-1]
        +
        unique_scores[1:]
    ) / 2


    thresholds = np.concatenate(
        [
            [
                np.nextafter(
                    unique_scores.min(),
                    -np.inf
                )
            ],
            midpoints,
            [
                np.nextafter(
                    unique_scores.max(),
                    np.inf
                )
            ]
        ]
    )


    records = []


    for threshold in thresholds:

        metrics = z_metrics(

            y_true=
                y_true,

            scores=
                scores,

            threshold=
                threshold
        )


        records.append(
            {
                "Threshold":
                    threshold,

                **metrics,

                "sens_spec_difference":
                    abs(
                        metrics["Sensitivity"]
                        -
                        metrics["Specificity"]
                    )
            }
        )


    table = pd.DataFrame(
        records
    )


    max_ba = table[
        "Balanced_Accuracy"
    ].max()


    candidates = (
        table[
            np.isclose(
                table[
                    "Balanced_Accuracy"
                ],
                max_ba,
                atol=1e-12
            )
        ]
        .copy()
    )


    min_diff = candidates[
        "sens_spec_difference"
    ].min()


    candidates = (
        candidates[
            np.isclose(
                candidates[
                    "sens_spec_difference"
                ],
                min_diff,
                atol=1e-12
            )
        ]
        .copy()
        .sort_values(
            "Threshold"
        )
        .reset_index(drop=True)
    )


    selected = candidates.iloc[
        len(candidates) // 2
    ]


    return (
        selected,
        table
    )


